  <!-- =====================================
       NAVIGATION MOBILE
  ====================================== -->

  <script>
    document.addEventListener("DOMContentLoaded", function () {

      const menuToggle = document.querySelector(".menu-toggle");
      const mainNav = document.querySelector(".main-nav");

      if (!menuToggle || !mainNav) {
        return;
      }


      function isMobileMenu() {
        return window.innerWidth <= 900;
      }


      /* =====================================
         MENU PRINCIPAL
      ====================================== */

      menuToggle.addEventListener("click", function () {

        mainNav.classList.toggle("open");

        menuToggle.setAttribute(
          "aria-expanded",
          mainNav.classList.contains("open") ? "true" : "false"
        );

      });


      /* =====================================
         SOUS-MENUS PRINCIPAUX
      ====================================== */

      document
        .querySelectorAll(".nav-item > .nav-link")
        .forEach(function (link) {

          const navItem = link.parentElement;

          const dropdown =
            navItem.querySelector(":scope > .dropdown-menu");

          if (!dropdown) {
            return;
          }

          link.addEventListener("click", function (event) {

            if (!isMobileMenu()) {
              return;
            }

            if (!navItem.classList.contains("submenu-open")) {

              event.preventDefault();

              document
                .querySelectorAll(".nav-item.submenu-open")
                .forEach(function (item) {

                  if (item !== navItem) {
                    item.classList.remove("submenu-open");
                  }

                });

              navItem.classList.add("submenu-open");
            }

          });

        });


      /* =====================================
         SOUS-MENU CONSEIL MUNICIPAL
      ====================================== */

      document
        .querySelectorAll(
          ".dropdown-submenu > .dropdown-submenu-link"
        )
        .forEach(function (link) {

          const submenu = link.parentElement;

          link.addEventListener("click", function (event) {

            if (!isMobileMenu()) {
              return;
            }

            if (!submenu.classList.contains("submenu-open")) {

              event.preventDefault();
              event.stopPropagation();

              submenu.classList.add("submenu-open");

            }

          });

        });


      /* =====================================
         RETOUR DESKTOP
      ====================================== */

      window.addEventListener("resize", function () {

        if (!isMobileMenu()) {

          mainNav.classList.remove("open");

          menuToggle.setAttribute(
            "aria-expanded",
            "false"
          );

          document
            .querySelectorAll(".submenu-open")
            .forEach(function (element) {
              element.classList.remove("submenu-open");
            });

        }

      });

    });
  </script>