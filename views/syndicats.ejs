<%- include("partials/header", { title }) %>

<main>

  <!-- =====================================
       HERO
  ====================================== -->

  <section class="page-hero">

    <div class="container">

      <span class="section-eyebrow light">
        La mairie
      </span>

      <h1>Syndicats & représentations</h1>

      <p>
        La commune de Saint-Loup-Cammas participe
        à plusieurs structures intercommunales
        et organismes chargés de services
        et de politiques publiques à l'échelle du territoire.
      </p>

    </div>

  </section>


  <!-- =====================================
       ORGANISMES
  ====================================== -->

  <section class="section">

    <div class="container">

      <div class="section-heading">

        <span class="section-eyebrow">
          Représentations
        </span>

        <h2>Les organismes du territoire</h2>

        <p>
          Saint-Loup-Cammas est représentée
          auprès de plusieurs organismes intervenant
          dans les domaines de l'eau, de l'énergie,
          des transports et de l'aménagement du territoire.
        </p>

      </div>


      <div class="demarches-grid">

        <div class="demarche-card">

          <div class="demarche-icon">💧</div>

          <div>

            <h3>Eau</h3>

            <p>
              Représentation de la commune
              auprès de la structure intercommunale
              compétente dans le domaine de l'eau.
            </p>

          </div>

        </div>


        <div class="demarche-card">

          <div class="demarche-icon">⚡</div>

          <div>

            <h3>Électricité</h3>

            <p>
              Représentation auprès du syndicat
              compétent en matière d'énergie
              et de réseau électrique.
            </p>

          </div>

        </div>


        <div class="demarche-card">

          <div class="demarche-icon">🚌</div>

          <div>

            <h3>Transports</h3>

            <p>
              La commune participe aux structures
              territoriales compétentes
              en matière de transports et de mobilité.
            </p>

          </div>

        </div>


        <div class="demarche-card">

          <div class="demarche-icon">🗺️</div>

          <div>

            <h3>Aménagement du territoire</h3>

            <p>
              Saint-Loup-Cammas participe
              aux démarches de planification
              et d'aménagement à l'échelle
              de l'agglomération toulousaine.
            </p>

          </div>

        </div>


        <a href="/intercommunalite" class="demarche-card">

          <div class="demarche-icon">🏘️</div>

          <div>

            <h3>Coteaux Bellevue</h3>

            <p>
              Retrouvez les informations concernant
              la Communauté de communes
              des Coteaux Bellevue.
            </p>

            <span>
              Consulter →
            </span>

          </div>

        </a>


        <a href="/developpement-durable" class="demarche-card">

          <div class="demarche-icon">🌱</div>

          <div>

            <h3>Développement durable</h3>

            <p>
              Urbanisme, environnement
              et aménagement durable
              du territoire.
            </p>

            <span>
              Consulter →
            </span>

          </div>

        </a>

      </div>

    </div>

  </section>


  <!-- =====================================
       INFORMATION
  ====================================== -->

  <section class="demarches-info">

    <div class="container demarches-info-grid">

      <div>

        <span class="section-eyebrow light">
          Représentation communale
        </span>

        <h2>Besoin d'une information ?</h2>

        <p>
          Pour connaître les représentants actuels
          de la commune auprès de ces organismes,
          vous pouvez contacter la mairie.
        </p>

      </div>


      <div class="demarches-contact">

        <strong>
          Mairie de Saint-Loup-Cammas
        </strong>

        <a href="tel:0534272850">
          05 34 27 28 50
        </a>

        <a href="/contact">
          Contact & accès →
        </a>

      </div>

    </div>

  </section>

</main>

<%- include("partials/footer") %>