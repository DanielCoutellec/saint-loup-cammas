<%- include("partials/header", { title }) %>

<main>

  <!-- =====================================
       HERO
  ====================================== -->

  <section class="page-hero">

    <div class="container">

      <span class="section-eyebrow light">
        La mairie
      </span>

      <h1>Le mot du maire</h1>

      <p>
        Le message de Sandrine Penavaire,
        Maire de Saint-Loup-Cammas.
      </p>

    </div>

  </section>


  <!-- =====================================
       MOT DU MAIRE
  ====================================== -->

  <section class="section mayor-message-section">

    <div class="container">

      <div class="mayor-message-grid">


        <!-- PHOTO DU MAIRE -->

        <div class="mayor-message-photo">

          <img
            src="/images/elus/sandrine-penavaire.jpg"
            alt="Sandrine Penavaire, Maire de Saint-Loup-Cammas"
          >

          <div class="mayor-message-identity">

            <strong>
              Sandrine Penavaire
            </strong>

            <span>
              Maire de Saint-Loup-Cammas
            </span>

          </div>

        </div>


        <!-- MESSAGE -->

        <div class="mayor-message-content">

          <h2>
            Chères Saint-Loupiennes,<br>
            chers Saint-Loupiens,
          </h2>

          <p>
            Au moment où vous venez de me confier la responsabilité
            de Maire, je souhaite tout d'abord vous adresser
            mes remerciements les plus sincères.
          </p>

          <p>
            Le budget communal est un exercice d'équilibre exigeant,
            qui doit concilier la qualité des services publics,
            les investissements nécessaires à notre territoire
            et la maîtrise des dépenses.
          </p>

          <p>
            Dans un contexte économique contraint, marqué par
            les difficultés financières que rencontrent nombre
            de nos administrés, nous sommes pleinement conscients
            de nos responsabilités.
          </p>

          <p>
            C'est pourquoi nous ferons tout notre possible
            pour éviter toute augmentation des impôts,
            en recherchant des solutions de gestion rigoureuses,
            des économies ciblées et toutes les aides dont nous
            pourrons bénéficier, afin de préserver le pouvoir
            d'achat de chacun.
          </p>

        </div>

      </div>

    </div>

  </section>


  <!-- =====================================
       ÉQUIPE MUNICIPALE
  ====================================== -->

  <section class="demarches-info">

    <div class="container demarches-info-grid">

      <div>

        <span class="section-eyebrow light">
          Conseil municipal
        </span>

        <h2>
          Découvrez l'équipe municipale
        </h2>

        <p>
          Retrouvez le maire, les adjoints
          et les conseillers municipaux
          de Saint-Loup-Cammas.
        </p>

      </div>


      <div class="demarches-contact">

        <a href="/maire-elus">
          Le maire et les élus →
        </a>

        <a href="/conseil-municipal">
          Conseil municipal →
        </a>

      </div>

    </div>

  </section>

</main>

<%- include("partials/footer") %>