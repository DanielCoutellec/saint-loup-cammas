<%- include("partials/header", { title }) %>

<main>

  <!-- =====================================
       HERO
  ====================================== -->

  <section class="page-hero">
    <div class="container">

      <span class="section-eyebrow light">
        Enfance
      </span>

      <h1>Accueils de loisirs</h1>

      <p>
        Retrouvez les informations concernant
        l'accueil périscolaire et extrascolaire
        proposé aux enfants de Saint-Loup-Cammas.
      </p>

    </div>
  </section>


  <!-- =====================================
       PRÉSENTATION
  ====================================== -->

  <section class="section">
    <div class="container">

      <div class="section-heading">

        <span class="section-eyebrow">
          Le Pré en Bulle
        </span>

        <h2>Accueil de loisirs</h2>

        <p>
          Le Pré en Bulle accueille les enfants
          en dehors du temps scolaire et pendant
          certaines périodes de vacances.
        </p>

      </div>


      <div class="demarches-grid">

        <div class="demarche-card">

          <div class="demarche-icon">🎨</div>

          <div>

            <h3>Accueil périscolaire</h3>

            <p>
              L'accueil périscolaire fonctionne
              tous les jours de classe,
              mercredi après-midi inclus.
            </p>

          </div>

        </div>


        <div class="demarche-card">

          <div class="demarche-icon">☀️</div>

          <div>

            <h3>Accueil extrascolaire</h3>

            <p>
              L'accueil extrascolaire fonctionne
              pendant les vacances scolaires.
            </p>

            <p>
              Il est fermé au mois d'août
              ainsi que pendant la semaine comprise
              entre Noël et le 1er janvier.
            </p>

          </div>

        </div>


        <div class="demarche-card">

          <div class="demarche-icon">👧</div>

          <div>

            <h3>À partir de 3 ans</h3>

            <p>
              Les accueils périscolaires
              et extrascolaires sont ouverts
              aux enfants âgés d'au moins 3 ans.
            </p>

          </div>

        </div>

      </div>

    </div>
  </section>


  <!-- =====================================
       HORAIRES PÉRISCOLAIRES
  ====================================== -->

  <section class="section useful-light-section">
    <div class="container">

      <div class="section-heading">

        <span class="section-eyebrow">
          Horaires
        </span>

        <h2>Accueil périscolaire</h2>

        <p>
          L'accueil périscolaire fonctionne
          tous les jours de classe,
          mercredi après-midi inclus.
        </p>

      </div>


      <div class="useful-contact-list">

        <div class="useful-contact-row">

          <div>
            <h3>Lundi et jeudi</h3>
            <p>Matin, pause méridienne et soir</p>
          </div>

          <strong>
            7h30 – 8h50<br>
            12h00 – 13h50<br>
            16h00 – 18h30
          </strong>

        </div>


        <div class="useful-contact-row">

          <div>
            <h3>Mardi et vendredi</h3>
            <p>Matin, pause méridienne et soir</p>
          </div>

          <strong>
            7h30 – 8h50<br>
            12h00 – 13h50<br>
            16h30 – 18h30
          </strong>

        </div>


        <div class="useful-contact-row">

          <div>

            <h3>Mercredi</h3>

            <p>
              Matin puis accueil de l'après-midi
              avec possibilité de départ échelonné.
            </p>

          </div>

          <strong>
            7h30 – 8h50<br>
            12h00 – 14h00<br>
            14h00 – 18h30
          </strong>

        </div>

      </div>


      <div class="municipal-alert" style="margin-top: 30px;">

        <div class="alert-icon">
          ℹ
        </div>

        <div>

          <strong>
            Le mercredi
          </strong>

          <p>
            De 12h00 à 14h00, les départs peuvent
            être échelonnés après le repas.
          </p>

          <p>
            De 14h00 à 18h30, les départs peuvent
            également être échelonnés,
            de préférence après le goûter à 16h30.
          </p>

        </div>

      </div>

    </div>
  </section>


  <!-- =====================================
       ARRIVÉE ET DÉPART
  ====================================== -->

  <section class="section">
    <div class="container">

      <div class="section-heading">

        <span class="section-eyebrow">
          Organisation
        </span>

        <h2>Arrivée et départ des enfants</h2>

        <p>
          Quelques règles permettent d'assurer
          le bon fonctionnement de l'accueil
          et la sécurité des enfants.
        </p>

      </div>


      <div class="demarches-grid">

        <div class="demarche-card">

          <div class="demarche-icon">
            ➡️
          </div>

          <div>

            <h3>À l'arrivée</h3>

            <p>
              L'heure d'arrivée de l'enfant
              est enregistrée sur la tablette
              par l'équipe d'animation.
            </p>

          </div>

        </div>


        <div class="demarche-card">

          <div class="demarche-icon">
            ⬅️
          </div>

          <div>

            <h3>Au départ</h3>

            <p>
              Les parents ou les personnes dûment habilitées
              doivent entrer par le hall de l'école.
            </p>

            <p>
              Après avoir récupéré l'enfant,
              le départ est enregistré sur la tablette
              par l'équipe d'animation.
            </p>

          </div>

        </div>


        <div class="demarche-card">

          <div class="demarche-icon">
            🕐
          </div>

          <div>

            <h3>Interclasse</h3>

            <p>
              Durant l'interclasse,
              le départ et l'arrivée des enfants
              avant 13h50 sont interdits.
            </p>

          </div>

        </div>

      </div>

    </div>
  </section>


  <!-- =====================================
       EXTRASCOLAIRE
  ====================================== -->

  <section class="section useful-light-section">
    <div class="container">

      <div class="section-heading">

        <span class="section-eyebrow">
          Vacances scolaires
        </span>

        <h2>Accueil extrascolaire</h2>

        <p>
          L'accueil de loisirs extrascolaire fonctionne
          pendant les vacances scolaires.
        </p>

        <p>
          Il est fermé au mois d'août
          ainsi que pendant la semaine comprise
          entre Noël et le 1er janvier.
        </p>

        <p>
          L'accueil extrascolaire est ouvert
          aux enfants âgés d'au moins 3 ans.
        </p>

      </div>


      <div class="useful-contact-list">

        <div class="useful-contact-row">

          <div>

            <h3>Horaires pendant les vacances</h3>

            <p>
              Pendant les périodes d'ouverture
            </p>

          </div>

          <strong>
            7h30 – 18h30
          </strong>

        </div>

      </div>

    </div>
  </section>


