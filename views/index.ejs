<!-- =====================================
     SLIDER
====================================== -->

<script>

  document.addEventListener("DOMContentLoaded", () => {

    const slides =
      document.querySelectorAll(".home-hero-slide");

    if (!slides.length) {
      return;
    }

    let currentSlide = 0;

    setInterval(() => {

      slides[currentSlide].classList.remove("active");

      currentSlide =
        (currentSlide + 1) % slides.length;

      slides[currentSlide].classList.add("active");

    }, 3000);

  });

</script>


