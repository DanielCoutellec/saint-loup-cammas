<%- include("partials/header", { title }) %>

<main>

  <!-- =====================================
       HERO
  ====================================== -->

  <section class="page-hero">

    <div class="container">

      <span class="section-eyebrow light">
        Prévention & solidarité
      </span>

      <h1>Plan canicule</h1>

      <p>
        Conseils de prévention et accompagnement
        des personnes âgées, fragiles ou isolées
        en période de fortes chaleurs.
      </p>

    </div>

  </section>


  <!-- =====================================
       CONSEILS DE PRÉVENTION
  ====================================== -->

  <section class="section useful-light-section">

    <div class="container">

      <div class="section-heading">

        <span class="section-eyebrow">
          Prévention
        </span>

        <h2>Canicule : quelques conseils</h2>

        <p>
          La municipalité rappelle les gestes simples
          à adopter en cas de fortes chaleurs.
        </p>

      </div>


      <div class="demarches-grid">

        <!-- LOGEMENT -->

        <div class="demarche-card">

          <div class="demarche-icon">
            🏠
          </div>

          <div>

            <h3>Garder le logement frais</h3>

            <p>
              Maintenir autant que possible
              son logement au frais pendant
              les périodes de fortes chaleurs.
            </p>

          </div>

        </div>


        <!-- HYDRATATION -->

        <div class="demarche-card">

          <div class="demarche-icon">
            💧
          </div>

          <div>

            <h3>S'hydrater régulièrement</h3>

            <p>
              Boire régulièrement
              tout au long de la journée.
            </p>

          </div>

        </div>


        <!-- SORTIES -->

        <div class="demarche-card">

          <div class="demarche-icon">
            ☀️
          </div>

          <div>

            <h3>Éviter les fortes chaleurs</h3>

            <p>
              Éviter les sorties pendant
              les heures les plus chaudes de la journée
              et se protéger des rayons du soleil,
              notamment en portant un chapeau.
            </p>

          </div>

        </div>

      </div>

    </div>

  </section>


  <!-- =====================================
       REGISTRE CCAS
  ====================================== -->

  <section class="section">

    <div class="container">

      <div class="section-heading">

        <span class="section-eyebrow">
          CCAS
        </span>

        <h2>Registre des personnes fragiles</h2>

        <p>
          Pour un meilleur accompagnement,
          le Centre communal d'action sociale (CCAS)
          tient un registre nominatif destiné
          à recenser les seniors
          et les personnes fragilisées.
        </p>

      </div>


      <div class="heritage-text">

        <p>
          En cas de déclenchement du plan départemental
          d'alerte et d'urgence, ce registre permet
          une intervention ciblée des services
          sanitaires et sociaux.
        </p>

        <p>
          Les administrés disposent d'un droit
          d'accès et de rectification
          des informations transmises.
        </p>

        <p>
          Les aides à domicile du CCAS sont également
          présentes pour veiller au bien-être
          des bénéficiaires de la structure
          en période de forte chaleur.
        </p>

      </div>

    </div>

  </section>


  <!-- =====================================
       QUI PEUT S'INSCRIRE ?
  ====================================== -->

  <section class="section useful-light-section">

    <div class="container">

      <div class="section-heading">

        <span class="section-eyebrow">
          Inscription
        </span>

        <h2>Qui peut s'inscrire ?</h2>

      </div>


      <div class="demarches-grid">

        <!-- PERSONNES ÂGÉES -->

        <div class="demarche-card">

          <div class="demarche-icon">
            👴
          </div>

          <div>

            <h3>Personnes âgées</h3>

            <p>
              Les personnes âgées de 65 ans et plus
              résidant à leur domicile.
            </p>

          </div>

        </div>


        <!-- PERSONNES HANDICAPÉES -->

        <div class="demarche-card">

          <div class="demarche-icon">
            ♿
          </div>

          <div>

            <h3>Personnes handicapées</h3>

            <p>
              Les personnes handicapées
              et isolées à leur domicile.
            </p>

          </div>

        </div>

      </div>

    </div>

  </section>


  <!-- =====================================
       COMMENT S'INSCRIRE ?
  ====================================== -->

  <section class="section">

    <div class="container">

      <div class="section-heading">

        <span class="section-eyebrow">
          Démarche
        </span>

        <h2>Comment s'inscrire ?</h2>

        <p>
          Les personnes susceptibles d'être inscrites
          sur ce registre doivent se faire connaître
          auprès de la mairie.
        </p>

      </div>


      <div class="demarches-grid">

        <!-- TÉLÉPHONE -->

        <div class="demarche-card">

          <div class="demarche-icon">
            🏛️
          </div>

          <div>

            <h3>Contacter la mairie</h3>

            <p>
              Pour demander votre inscription
              ou obtenir des renseignements,
              contactez la mairie
              de Saint-Loup-Cammas.
            </p>

            <a href="tel:0534272850">
              05 34 27 28 50
            </a>

          </div>

        </div>


        <!-- CONTACT -->

        <div class="demarche-card">

          <div class="demarche-icon">
            ✉️
          </div>

          <div>

            <h3>Formulaire de contact</h3>

            <p>
              Vous pouvez également utiliser
              le formulaire de contact du site.
            </p>

            <a href="/contact">
              Contacter la mairie →
            </a>

          </div>

        </div>

      </div>

    </div>

  </section>


  <!-- =====================================
       VIGILANCE
  ====================================== -->

  <section class="section useful-light-section">

    <div class="container">

      <div class="municipal-alert">

        <div class="alert-icon">
          !
        </div>

        <div>

          <strong>
            Pensez aux personnes isolées
          </strong>

          <p>
            En période de fortes chaleurs,
            une attention particulière doit être portée
            aux personnes âgées, fragiles ou isolées.
            N'hésitez pas à signaler à la mairie
            une personne susceptible d'avoir besoin
            d'un accompagnement.
          </p>

        </div>

      </div>

    </div>

  </section>


  <!-- =====================================
       CONTACT
  ====================================== -->

  <section class="demarches-info">

    <div class="container demarches-info-grid">

      <div>

        <span class="section-eyebrow light">
          Prévention & solidarité
        </span>

        <h2>Besoin d'un renseignement ?</h2>

        <p>
          La mairie peut vous renseigner
          sur le registre des personnes fragiles
          et les dispositifs d'accompagnement
          mis en place en période de canicule.
        </p>

      </div>


      <div class="demarches-contact">

        <strong>
          Mairie de Saint-Loup-Cammas
        </strong>

        <a href="tel:0534272850">
          05 34 27 28 50
        </a>

        <a href="/solidarite">
          Solidarité & action sociale →
        </a>

        <a href="/vie-quotidienne">
          Vie quotidienne →
        </a>

        <a href="/contact">
          Contact & accès →
        </a>

      </div>

    </div>

  </section>

</main>

<%- include("partials/footer") %>