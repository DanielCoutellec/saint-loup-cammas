<%- include("partials/header", { title }) %>

<main>

  <section class="page-hero">
    <div class="container">

      <span class="section-eyebrow light">
        Vie municipale
      </span>

      <h1>Travaux</h1>

      <p>
        Retrouvez les principaux travaux prévus et réalisés
        dans la commune de Saint-Loup-Cammas.
      </p>

    </div>
  </section>


  <!-- TRAVAUX PREVUS 2026 -->

  <section class="section">

    <div class="container">

      <div class="section-heading">

        <span class="section-eyebrow">
          Programme 2026
        </span>

        <h2>Travaux prévus en 2026</h2>

      </div>


      <div class="demarches-grid">

        <div class="demarche-card">

          <div class="demarche-icon">
            🏗️
          </div>

          <div>

            <h3>Atelier</h3>

            <p>
              Enduits de façades et différents travaux
              de remise en état.
            </p>

          </div>

        </div>

      </div>

    </div>

  </section>


  <!-- TRAVAUX TERMINES 2025 -->

  <section class="section elected-section">

    <div class="container">

      <div class="section-heading">

        <span class="section-eyebrow">
          Réalisations
        </span>

        <h2>Travaux terminés en 2025</h2>

        <p>
          Plusieurs opérations d'aménagement, de sécurisation
          et de rénovation ont été réalisées dans la commune.
        </p>

      </div>


      <div class="travaux-list">


        <!-- GOTIS -->

        <article class="travaux-card">

          <div class="travaux-number">
            01
          </div>

          <div>

            <h3>
              Chemin d'accès à la station d'épuration de Gotis
            </h3>

            <p>
              Des travaux ont été réalisés afin de sécuriser
              le passage des poids lourds accédant à la station
              d'épuration.
            </p>

            <p>
              Ils comprennent notamment le renforcement
              de la berge du fossé par enrochement ainsi que
              le reprofilage du fil d'eau afin d'améliorer
              l'écoulement des eaux pluviales.
            </p>

          </div>

        </article>


        <!-- ALLEE DES PINS -->

        <article class="travaux-card">

          <div class="travaux-number">
            02
          </div>

          <div>

            <h3>
              Allée des Pins
            </h3>

            <p>
              Réfection des trottoirs, des places
              de stationnement et de la chaussée,
              à la suite des dégradations naturelles
              liées au vieillissement.
            </p>

            <p>
              Les arbres ont également été remplacés.
              Les jeunes arbres pouvant être conservés
              ont été déplacés ailleurs dans la commune.
            </p>

          </div>

        </article>


        <!-- MIMOSAS -->

        <article class="travaux-card">

          <div class="travaux-number">
            03
          </div>

          <div>

            <h3>
              Allée des Mimosas
            </h3>

            <p>
              Réfection du revêtement de la chaussée
              à l'entrée du lotissement des Mimosas.
            </p>

          </div>

        </article>


        <!-- ECLAIRAGE -->

        <article class="travaux-card">

          <div class="travaux-number">
            04
          </div>

          <div>

            <h3>
              Éclairage public
            </h3>

            <p>
              Remplacement des anciennes lanternes équipées
              de lampes sodium énergivores par des lanternes LED.
            </p>

            <p>
              L'opération concerne notamment les lotissements
              Le Petit Bois, Les Terrasses du Soleil
              et l'impasse Bellevue.
            </p>

            <p>
              Environ une centaine de points lumineux
              sont concernés dans le cadre du programme LED++.
            </p>

          </div>

        </article>


        <!-- PONT DE CARLES -->

        <article class="travaux-card">

          <div class="travaux-number">
            05
          </div>

          <div>

            <h3>
              Pont de Carles
            </h3>

            <p>
              L'ancien pont a été démoli et remplacé
              par un nouvel ouvrage permettant une circulation
              dans les deux sens.
            </p>

            <p>
              Les travaux ont débuté le 7 avril
              pour une durée annoncée de six mois,
              avec fermeture totale de la circulation
              pendant le chantier.
            </p>

          </div>

        </article>


        <!-- PLACE EGLISE -->

        <article class="travaux-card">

          <div class="travaux-number">
            06
          </div>

          <div>

            <h3>
              Place de l'église
            </h3>

            <p>
              Travaux d'assainissement, réfection
              et amélioration des allées et des marches.
            </p>

            <p>
              Un enrobé drainant de couleur a été mis en œuvre
              sur les allées et les chemins.
            </p>

          </div>

        </article>


      </div>

    </div>

  </section>


  <!-- CONTACT -->

  <section class="demarches-info">

    <div class="container demarches-info-grid">

      <div>

        <span class="section-eyebrow light">
          Travaux municipaux
        </span>

        <h2>Besoin d'un renseignement ?</h2>

        <p>
          Pour toute question concernant un chantier
          ou des travaux réalisés dans la commune,
          vous pouvez contacter les services municipaux.
        </p>

      </div>


      <div class="demarches-contact">

        <strong>
          Mairie de Saint-Loup-Cammas
        </strong>

        <a href="tel:0534272850">
          05 34 27 28 50
        </a>

      </div>

    </div>

  </section>

</main>

<%- include("partials/footer") %>