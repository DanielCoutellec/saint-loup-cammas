<%- include("partials/header", { title }) %>

<main>

  <!-- =====================================
       HERO
  ====================================== -->

  <section class="page-hero">

    <div class="container">

      <span class="section-eyebrow light">
        Démarches
      </span>

      <h1>Cimetière</h1>

      <p>
        Retrouvez les informations utiles concernant
        le cimetière communal, les concessions
        et les principales démarches funéraires.
      </p>

    </div>

  </section>


  <!-- =====================================
       INFORMATIONS ET DÉMARCHES
  ====================================== -->

  <section class="section">

    <div class="container">

      <div class="section-heading">

        <span class="section-eyebrow">
          Cimetière communal
        </span>

        <h2>Informations et démarches</h2>

        <p>
          Pour toute demande concernant une concession,
          une inhumation ou une démarche relative
          au cimetière, la mairie peut vous renseigner.
        </p>

      </div>


      <div class="demarches-grid">


        <!-- CONCESSIONS -->

        <div class="demarche-card">

          <div class="demarche-icon">
            🏛️
          </div>

          <div>

            <h3>Concessions funéraires</h3>

            <p>
              Pour connaître les possibilités d'acquisition,
              de renouvellement ou de reprise d'une concession,
              contactez les services de la mairie.
            </p>

            <span>
              Renseignements en mairie
            </span>

          </div>

        </div>


        <!-- INHUMATION -->

        <div class="demarche-card">

          <div class="demarche-icon">
            🕊️
          </div>

          <div>

            <h3>Inhumation</h3>

            <p>
              Les démarches liées à une inhumation
              sont effectuées en lien avec la famille,
              l'opérateur funéraire et la commune.
            </p>

            <span>
              Contacter la mairie
            </span>

          </div>

        </div>


        <!-- COLUMBARIUM -->

        <div class="demarche-card">

          <div class="demarche-icon">
            🏛️
          </div>

          <div>

            <h3>Columbarium et urnes</h3>

            <p>
              Pour toute information concernant
              le dépôt d'une urne ou les équipements
              cinéraires disponibles dans la commune,
              contactez la mairie.
            </p>

            <span>
              Renseignements en mairie
            </span>

          </div>

        </div>


        <!-- DÉCLARATION DE DÉCÈS -->

        <a
          href="https://www.service-public.fr/particuliers/vosdroits/F16507"
          target="_blank"
          rel="noopener"
          class="demarche-card"
        >

          <div class="demarche-icon">
            📄
          </div>

          <div>

            <h3>Déclaration de décès</h3>

            <p>
              Retrouvez les informations officielles
              concernant la déclaration d'un décès
              et les démarches à effectuer.
            </p>

            <span>
              Consulter →
            </span>

          </div>

        </a>


        <!-- ACTE DE DÉCÈS -->

        <a
          href="https://www.service-public.fr/particuliers/vosdroits/F1444"
          target="_blank"
          rel="noopener"
          class="demarche-card"
        >

          <div class="demarche-icon">
            📜
          </div>

          <div>

            <h3>Acte de décès</h3>

            <p>
              Consultez les informations nécessaires
              pour demander une copie
              d'un acte de décès.
            </p>

            <span>
              Consulter →
            </span>

          </div>

        </a>


        <!-- ÉTAT CIVIL -->

        <a
          href="/etat-civil"
          class="demarche-card"
        >

          <div class="demarche-icon">
            🏢
          </div>

          <div>

            <h3>État civil</h3>

            <p>
              Retrouvez les autres démarches
              d'état civil proposées sur le site
              de la commune.
            </p>

            <span>
              Voir les démarches →
            </span>

          </div>

        </a>

      </div>

    </div>

  </section>


  <!-- =====================================
       INFORMATION CONCESSIONS
  ====================================== -->

  <section class="section useful-light-section">

    <div class="container">

      <div class="municipal-alert">

        <div class="alert-icon">
          !
        </div>

        <div>

          <strong>
            Besoin d'une information sur une concession ?
          </strong>

          <p>
            Les conditions, tarifs et disponibilités
            des concessions peuvent évoluer.
            Contactez la mairie pour obtenir
            les informations actualisées.
          </p>

        </div>

      </div>

    </div>

  </section>


  <!-- =====================================
       CONTACT
  ====================================== -->

  <section class="demarches-info">

    <div class="container demarches-info-grid">

      <div>

        <span class="section-eyebrow light">
          Service cimetière
        </span>

        <h2>Une démarche à effectuer ?</h2>

        <p>
          Pour toute demande concernant le cimetière communal,
          une concession ou une démarche funéraire,
          contactez directement les services de la mairie.
        </p>

      </div>


      <div class="demarches-contact">

        <strong>
          Mairie de Saint-Loup-Cammas
        </strong>

        <a href="tel:0534272850">
          05 34 27 28 50
        </a>

        <a href="/contact">
          Contact & accès →
        </a>

      </div>

    </div>

  </section>

</main>

<%- include("partials/footer") %>