<%- include("partials/header", { title }) %>

<main>

  <section class="page-hero">
    <div class="container">

      <span class="section-eyebrow light">
        Vie locale
      </span>

      <h1>Transports</h1>

      <p>
        Retrouvez les informations pour vous déplacer
        à Saint-Loup-Cammas et rejoindre l'agglomération toulousaine.
      </p>

    </div>
  </section>


  <section class="section">

    <div class="container">

      <div class="section-heading">

        <span class="section-eyebrow">
          Se déplacer
        </span>

        <h2>Venir et se déplacer à Saint-Loup-Cammas</h2>

        <p>
          Transports en commun, vélo, marche et accès routiers :
          retrouvez les principales solutions de déplacement.
        </p>

      </div>


      <div class="demarches-grid">

        <div class="demarche-card">

          <div class="demarche-icon">🚌</div>

          <div>
            <h3>Bus – Ligne 33</h3>

            <p>
              La ligne 33 dessert Saint-Loup-Cammas
              en direction des Argoulets, avec correspondance
              avec le métro ligne A pour rejoindre Toulouse.
            </p>
          </div>

        </div>


        <div class="demarche-card">

          <div class="demarche-icon">🚇</div>

          <div>
            <h3>Métro</h3>

            <p>
              La ligne 33 permet de rejoindre Argoulets
              et la ligne A du métro toulousain.
            </p>
          </div>

        </div>


        <div class="demarche-card">

          <div class="demarche-icon">🚲</div>

          <div>
            <h3>Vélo</h3>

            <p>
              Des aménagements cyclables permettent
              de favoriser les déplacements à vélo
              sur le territoire.
            </p>
          </div>

        </div>


        <div class="demarche-card">

          <div class="demarche-icon">🚶</div>

          <div>
            <h3>À pied</h3>

            <p>
              La commune encourage également les déplacements
              à pied et les mobilités douces.
            </p>
          </div>

        </div>


        <div class="demarche-card">

          <div class="demarche-icon">🚗</div>

          <div>
            <h3>Accès routier</h3>

            <p>
              Saint-Loup-Cammas est accessible depuis Toulouse
              notamment par Croix-Daurade, L'Union
              et Saint-Geniès-Bellevue.
            </p>
          </div>

        </div>


        <a
          href="https://www.tisseo.fr/"
          target="_blank"
          rel="noopener"
          class="demarche-card"
        >

          <div class="demarche-icon">ℹ️</div>

          <div>
            <h3>Horaires Tisséo</h3>

            <p>
              Consultez les horaires, itinéraires
              et informations actualisées du réseau Tisséo.
            </p>

            <span>Consulter Tisséo ↗</span>
          </div>

        </a>

      </div>

    </div>

  </section>


  <section class="demarches-info">

    <div class="container demarches-info-grid">

      <div>

        <span class="section-eyebrow light">
          Transports en commun
