<%- include("partials/header", { title }) %>

<main>

  <!-- =====================================
       HERO
  ====================================== -->

  <section class="page-hero">
    <div class="container">

      <span class="section-eyebrow light">
        Vie quotidienne
      </span>

      <h1>Transports</h1>

      <p>
        Bus, métro, vélo, marche :
        retrouvez les principales solutions
        pour vous déplacer depuis Saint-Loup-Cammas.
      </p>

    </div>
  </section>


  <!-- =====================================
       TRANSPORTS EN COMMUN
  ====================================== -->

  <section class="section">

    <div class="container">

      <div class="section-heading">

        <span class="section-eyebrow">
          Transports en commun
        </span>

        <h2>Saint-Loup-Cammas → Toulouse</h2>

        <p>
          La commune est desservie par la ligne 33
          du réseau Tisséo, qui permet notamment
          de rejoindre le métro toulousain.
        </p>

      </div>


      <div class="demarches-grid">

        <div class="demarche-card">

          <div class="demarche-icon">
            🚌
          </div>

          <div>

            <h3>Bus – Ligne 33</h3>

            <p>
              La ligne 33 relie Argoulets
              à Gratentour Gravette
              en passant par Saint-Loup-Cammas.
            </p>

            <p>
              Le dimanche, son itinéraire
              se poursuit jusqu'à Bruguières.
            </p>

          </div>

        </div>


        <div class="demarche-card">

          <div class="demarche-icon">
            Ⓜ️
          </div>

          <div>

            <h3>Métro ligne A</h3>

            <p>
              La ligne 33 permet de rejoindre
              la station Argoulets
              et la ligne A du métro.
            </p>

          </div>

        </div>


        <div class="demarche-card">

          <div class="demarche-icon">
            Ⓜ️
          </div>

          <div>

            <h3>Métro ligne B</h3>

            <p>
              La ligne 33 dessert également Borderouge,
              permettant une correspondance
              avec la ligne B du métro.
            </p>

          </div>

        </div>

      </div>

    </div>

  </section>


  <!-- =====================================
       TRANSPORT COURSES
  ====================================== -->

  <section class="section useful-light-section">

    <div class="container">

      <div class="section-heading">

        <span class="section-eyebrow">
          Service de proximité
        </span>

        <h2>Transport courses</h2>

        <p>
          Chaque premier vendredi du mois,
          une sortie transport courses est normalement organisée
          vers le centre commercial Leclerc
          de Rouffiac-Tolosan.
        </p>

      </div>


      <div class="municipal-alert">

        <div class="alert-icon">
          !
        </div>

        <div>

          <strong>
            Service momentanément interrompu
          </strong>

          <p>
            Le service est actuellement interrompu
            en raison du manque de participants.
          </p>

          <p>
            Pour connaître une éventuelle reprise du service
            ou vous inscrire, contactez la mairie au
            <a href="tel:0534272850">
              05 34 27 28 50
            </a>.
          </p>

        </div>

      </div>

    </div>

  </section>


  <!-- =====================================
       HORAIRES
  ====================================== -->

  <section class="section">

    <div class="container">

      <div class="section-heading">

        <span class="section-eyebrow">
          Ligne 33
        </span>

        <h2>Horaires & itinéraires</h2>

        <p>
          Les horaires peuvent évoluer selon
          les périodes de l'année et les travaux sur le réseau.
          Consultez Tisséo avant votre déplacement.
        </p>

      </div>


      <div class="demarches-grid">

        <a
          href="https://www.tisseo.fr/sites/default/files/fh/Tisseo_ligne_33web.pdf"
          target="_blank"
          rel="noopener"
          class="demarche-card"
        >

          <div class="demarche-icon">
            📅
          </div>

          <div>

            <h3>Horaires ligne 33</h3>

            <p>
              Consultez la fiche horaire
              publiée par Tisséo.
            </p>

            <span>
              Voir les horaires →
            </span>

          </div>

        </a>


        <a
          href="https://plan-interactif.tisseo.fr/route-calculation"
          target="_blank"
          rel="noopener"
          class="demarche-card"
        >

          <div class="demarche-icon">
            🧭
          </div>

          <div>

            <h3>Calculer un itinéraire</h3>

            <p>
              Préparez votre déplacement
              et trouvez le trajet le plus adapté
              sur le réseau Tisséo.
            </p>

            <span>
              Calculer mon trajet →
            </span>

          </div>

        </a>


        <a
          href="https://plan-interactif.tisseo.fr/"
          target="_blank"
          rel="noopener"
          class="demarche-card"
        >

          <div class="demarche-icon">
            🗺️
          </div>

          <div>

            <h3>Plan du réseau</h3>

            <p>
              Consultez les lignes,
              les arrêts et les correspondances
              sur le plan interactif Tisséo.
            </p>

            <span>
              Voir le plan →
            </span>

          </div>

        </a>

      </div>

    </div>

  </section>


  <!-- =====================================
       MOBILITÉS DOUCES
  ====================================== -->

  <section class="section useful-light-section">

    <div class="container">

      <div class="section-heading">

        <span class="section-eyebrow">
          Mobilités douces
        </span>

        <h2>À vélo & à pied</h2>

        <p>
          Les déplacements de proximité peuvent également
          être effectués grâce aux cheminements
          et aux aménagements dédiés aux mobilités douces.
        </p>

      </div>


      <div class="demarches-grid">

        <div class="demarche-card">

          <div class="demarche-icon">
            🚲
          </div>

          <div>

            <h3>À vélo</h3>

            <p>
              Les aménagements cyclables
              et les voies partagées facilitent
              progressivement les déplacements
              à vélo sur le territoire.
            </p>

          </div>

        </div>


        <div class="demarche-card">

          <div class="demarche-icon">
            🚶
          </div>

          <div>

            <h3>À pied</h3>

            <p>
              Les cheminements piétons
              et voies douces permettent
              les déplacements de proximité
              et les promenades.
            </p>

          </div>

        </div>


        <a href="/commune-patrimoine" class="demarche-card">

          <div class="demarche-icon">
            🌳
          </div>

          <div>

            <h3>Chemins & promenades</h3>

            <p>
              Découvrez également les chemins,
              paysages et promenades
              de Saint-Loup-Cammas.
            </p>

            <span>
              Découvrir →
            </span>

          </div>

        </a>

      </div>

    </div>

  </section>


  <!-- =====================================
       VOITURE
  ====================================== -->

  <section class="section">

    <div class="container">

      <div class="section-heading">

        <span class="section-eyebrow">
          Accès
        </span>

        <h2>En voiture</h2>

      </div>


      <div class="demarches-grid">

        <div class="demarche-card">

          <div class="demarche-icon">
            🚗
          </div>

          <div>

            <h3>Depuis Toulouse</h3>

            <p>
              Saint-Loup-Cammas est située
              au nord-est de l'agglomération toulousaine,
              à une douzaine de kilomètres de Toulouse.
            </p>

            <p>
              La commune est notamment accessible
              par L'Union et Saint-Geniès-Bellevue.
            </p>

          </div>

        </div>


        <a href="/contact" class="demarche-card">

          <div class="demarche-icon">
            📍
          </div>

          <div>

            <h3>Venir à la mairie</h3>

            <p>
              Retrouvez l'adresse,
              le plan d'accès et les coordonnées
              de la mairie.
            </p>

            <span>
              Voir l'accès →
            </span>

          </div>

        </a>

      </div>

    </div>

  </section>


  <!-- =====================================
       TISSÉO
  ====================================== -->

  <section class="demarches-info">

    <div class="container demarches-info-grid">

      <div>

        <span class="section-eyebrow light">
          Transports en commun
        </span>

        <h2>Préparez votre déplacement</h2>

        <p>
          Pour connaître les prochains passages,
          perturbations et modifications du réseau,
          consultez directement Tisséo.
        </p>

      </div>


      <div class="demarches-contact">

        <strong>
          Tisséo
        </strong>

        <a href="tel:0561417070">
          05 61 41 70 70
        </a>

        <a
          href="https://www.tisseo.fr/"
          target="_blank"
          rel="noopener"
        >
          Site Tisséo →
        </a>

      </div>

    </div>

  </section>

</main>

<%- include("partials/footer") %>