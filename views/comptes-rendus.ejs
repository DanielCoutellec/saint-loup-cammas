<%- include("partials/header", { title }) %>

<main>

  <!-- =====================================
       HERO
  ====================================== -->

  <section class="page-hero">

    <div class="container">

      <span class="section-eyebrow light">
        La mairie
      </span>

      <h1>Comptes rendus du Conseil municipal</h1>

      <p>
        Retrouvez les comptes rendus,
        procès-verbaux et documents relatifs
        aux séances du Conseil municipal
        de Saint-Loup-Cammas.
      </p>

    </div>

  </section>


  <!-- =====================================
       INTRODUCTION
  ====================================== -->

  <section class="section">

    <div class="container">

      <div class="section-heading">

        <span class="section-eyebrow">
          Conseil municipal
        </span>

        <h2>Les séances du Conseil municipal</h2>

        <p>
          Les documents sont classés
          par année et par date de séance
          afin de faciliter leur consultation.
        </p>

      </div>

    </div>

  </section>


  <!-- =====================================
