      { date: "18/09/2014" },
      { date: "26/06/2014" },
      { date: "05/05/2014" },
      { date: "17/02/2014" },

      { date: "01/12/2013" },
      { date: "17/10/2013" }

    ];

    const annees = {};

    comptesRendus.forEach(document => {

      const annee = document.date.split("/")[2];

      if (!annees[annee]) {
        annees[annee] = [];
      }

      annees[annee].push(document);

    });
  %>


  <!-- =====================================
       ARCHIVES
  ====================================== -->

  <% Object.keys(annees)
       .sort((a, b) => b - a)
       .forEach((annee, index) => { %>

    <section
      class="section <%= index % 2 === 0 ? 'useful-light-section' : '' %>"
    >

      <div class="container">

        <div class="section-heading">

          <span class="section-eyebrow">
            Archives
          </span>

          <h2>
            <%= annee %>
          </h2>

          <p>
            Séances du Conseil municipal
            pour l'année <%= annee %>.
          </p>

        </div>


        <div class="council-documents">

          <% annees[annee].forEach(document => { %>

            <div class="council-document-row">

              <div class="council-document-date">

                <span class="council-document-icon">
                  📄
                </span>

                <div>

                  <strong>
                    Conseil municipal
                  </strong>

                  <span>
                    Séance du <%= document.date %>
                  </span>

                </div>

              </div>


              <%
  const [jour, mois, anneeDoc] = document.date.split("/");

  const fichierPdf =
    `/documents/conseil-municipal/${anneeDoc}/${anneeDoc}-${mois}-${jour}-conseil-municipal.pdf`;
%>

<a
  href="<%= fichierPdf %>"
  target="_blank"
  rel="noopener"
  class="btn btn-primary"
>
  Télécharger le PDF
</a>

            </div>

          <% }) %>

        </div>

      </div>

    </section>

  <% }) %>


  <!-- =====================================
       LIENS UTILES
  ====================================== -->

  <section class="section">

    <div class="container">

      <div class="section-heading">

        <span class="section-eyebrow">
          Conseil municipal
        </span>

        <h2>À consulter également</h2>

      </div>


      <div class="demarches-grid">

        <a
          href="/conseil-municipal"
          class="demarche-card"
        >

          <div class="demarche-icon">
            🏛️
          </div>

          <div>

            <h3>Le Conseil municipal</h3>

            <p>
              Retrouvez les informations
              relatives au Conseil municipal.
            </p>

            <span>
              Consulter →
            </span>

          </div>

        </a>


        <a
          href="/fonctionnement-conseil-municipal"
          class="demarche-card"
        >

          <div class="demarche-icon">
            ⚙️
          </div>

          <div>

            <h3>Fonctionnement</h3>

            <p>
              Découvrez le cheminement
              d'une décision municipale.
            </p>

            <span>
              Consulter →
            </span>

          </div>

        </a>


        <a
          href="/commissions"
          class="demarche-card"
        >

          <div class="demarche-icon">
            👥
          </div>

          <div>

            <h3>Commissions municipales</h3>

            <p>
              Consultez la composition
              des commissions municipales.
            </p>

            <span>
              Consulter →
            </span>

          </div>

        </a>

      </div>

    </div>

  </section>


  <!-- =====================================
       CONTACT
  ====================================== -->

  <section class="demarches-info">

    <div class="container demarches-info-grid">

      <div>

        <span class="section-eyebrow light">
          Conseil municipal
        </span>

        <h2>Besoin d'un document ?</h2>

        <p>
          Pour toute question concernant
          une séance ou un document
          du Conseil municipal,
          contactez la mairie.
        </p>

      </div>


      <div class="demarches-contact">

        <strong>
          Mairie de Saint-Loup-Cammas
        </strong>

        <a href="tel:0534272850">
          05 34 27 28 50
        </a>

        <a href="/contact">
          Contact & accès →
        </a>

      </div>

    </div>

  </section>

</main>

<%- include("partials/footer") %>