<%- include("partials/header", { title }) %>

<main>

  <section class="page-hero">
    <div class="container">

      <span class="section-eyebrow light">
        Démarches
      </span>

      <h1>Élections</h1>

      <p>
        Retrouvez les informations utiles concernant
        l'inscription sur les listes électorales,
        votre situation électorale et le vote.
      </p>

    </div>
  </section>


  <section class="section">

    <div class="container">

      <div class="section-heading">

        <span class="section-eyebrow">
          Citoyenneté
        </span>

        <h2>Vos démarches électorales</h2>

        <p>
          Accédez directement aux principaux services
          officiels concernant les élections.
        </p>

      </div>


      <div class="demarches-grid">

        <a
          href="https://www.service-public.fr/particuliers/vosdroits/R16396"
          target="_blank"
          rel="noopener"
          class="demarche-card"
        >

          <div class="demarche-icon">🗳️</div>

          <div>
            <h3>Inscription sur les listes électorales</h3>

            <p>
              Effectuez votre demande d'inscription
              sur les listes électorales en ligne.
            </p>

            <span>Faire la démarche →</span>
          </div>

        </a>


        <a
          href="https://www.service-public.fr/particuliers/vosdroits/R51788"
          target="_blank"
          rel="noopener"
          class="demarche-card"
        >

          <div class="demarche-icon">🔎</div>

          <div>
            <h3>Vérifier son inscription</h3>

            <p>
              Vérifiez votre inscription,
              votre bureau de vote
              et votre numéro national d'électeur.
            </p>

            <span>Vérifier →</span>
          </div>

        </a>


        <a
          href="https://www.maprocuration.gouv.fr/"
          target="_blank"
          rel="noopener"
          class="demarche-card"
        >

          <div class="demarche-icon">✍️</div>

          <div>
            <h3>Procuration</h3>

            <p>
              Préparez votre procuration
              si vous ne pouvez pas vous déplacer
              pour voter.
            </p>

            <span>Faire une procuration →</span>
          </div>

        </a>


        <a
          href="https://www.service-public.fr/particuliers/vosdroits/F1962"
          target="_blank"
          rel="noopener"
          class="demarche-card"
        >

          <div class="demarche-icon">📮</div>

          <div>
            <h3>Carte électorale</h3>

            <p>
              Retrouvez les informations concernant
              la carte électorale et son utilisation.
            </p>

            <span>Consulter →</span>
          </div>

        </a>


        <a
          href="https://www.service-public.fr/particuliers/vosdroits/F34240"
          target="_blank"
          rel="noopener"
          class="demarche-card"
        >

          <div class="demarche-icon">🏠</div>

          <div>
            <h3>Déménagement</h3>

            <p>
              Vous venez d'emménager à Saint-Loup-Cammas ?
              Vérifiez les démarches nécessaires
              pour mettre à jour votre inscription électorale.
            </p>

            <span>Consulter →</span>
          </div>

        </a>


        <a
          href="https://www.service-public.fr/particuliers/vosdroits/N47"
          target="_blank"
          rel="noopener"
          class="demarche-card"
        >

          <div class="demarche-icon">🇫🇷</div>

          <div>
            <h3>Élections & droit de vote</h3>

            <p>
              Consultez les informations officielles
              concernant le vote et les différentes élections.
            </p>

            <span>En savoir plus →</span>
          </div>

        </a>

      </div>

    </div>

  </section>


  <section class="section useful-light-section">

    <div class="container">

      <div class="section-heading">

        <span class="section-eyebrow">
          Inscription
        </span>

        <h2>S'inscrire à Saint-Loup-Cammas</h2>

        <p>
          L'inscription peut être effectuée en ligne
          ou directement auprès de la mairie avec les justificatifs nécessaires.
        </p>

      </div>


      <div class="municipal-alert">

        <div class="alert-icon">!</div>

        <div>

          <strong>
            Pensez à vérifier votre situation électorale
          </strong>

          <p>
            Le service en ligne officiel permet de connaître
            votre commune d'inscription et votre bureau de vote.
          </p>

        </div>

      </div>

    </div>

  </section>


  <section class="demarches-info">

    <div class="container demarches-info-grid">

      <div>

        <span class="section-eyebrow light">
          Service élections
        </span>

        <h2>Une question sur votre inscription ?</h2>

        <p>
          Pour toute question concernant les listes électorales,
          votre bureau de vote ou les démarches à effectuer,
          contactez la mairie.
        </p>

      </div>


      <div class="demarches-contact">

        <strong>
          Mairie de Saint-Loup-Cammas
        </strong>

        <a href="tel:0534272850">
          05 34 27 28 50
        </a>

        <a href="/contact">
          Contact & accès →
        </a>

      </div>

    </div>

  </section>

</main>

<%- include("partials/footer") %>