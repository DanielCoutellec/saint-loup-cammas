<%- include("partials/header", { title }) %>

<main>

  <!-- =====================================
       HERO
  ====================================== -->

  <section class="page-hero">

    <div class="container">

      <span class="section-eyebrow light">
        La commune
      </span>

      <h1>L'Église</h1>

      <p>
        Découvrez l'histoire de l'église
        de Saint-Loup-Cammas et les principales étapes
        de son évolution.
      </p>

    </div>

  </section>


  <!-- =====================================
       HISTOIRE DE L'ÉGLISE
  ====================================== -->

  <section class="section">

    <div class="container">

      <div class="section-heading">

        <span class="section-eyebrow">
          Patrimoine
        </span>

        <h2>L'église de Saint-Loup-Cammas</h2>

        <p>
          L'église constitue l'un des principaux repères
          historiques et patrimoniaux de la commune.
        </p>

      </div>


      <div class="heritage-grid">

        <div class="heritage-image">

          <img
            src="/images/histoire/eglise-ancienne.jpg"
            alt="Vue ancienne de l'église de Saint-Loup-Cammas"
          >

        </div>


        <div class="heritage-content">

          <h3>Saint Loup</h3>

          <p>
            Saint Loup, également appelé Saint Leu,
            est né à Toul vers 383
            et est mort en 479.
          </p>

          <p>
            Il fut nommé évêque de Troyes,
            ville qu'il sauva des fureurs d'Attila en 451.
          </p>

          <p>
            Saint Loup est fêté le
            <strong>3 septembre</strong>.
            C'est pour cette raison que la fête locale
            avait autrefois lieu le premier dimanche
            de septembre.
          </p>

        </div>

      </div>

    </div>

  </section>


  <!-- =====================================
       CONSTRUCTION
  ====================================== -->

  <section class="section useful-light-section">

    <div class="container">

      <div class="section-heading">

        <span class="section-eyebrow">
          XVIe siècle
        </span>

        <h2>Une église construite vers 1550</h2>

      </div>


      <div class="heritage-text">

        <p>
          L'église de Saint-Loup fut construite
          vers <strong>1550-1560</strong>.
        </p>

        <p>
          À l'origine, elle ne possédait
          ni sacristie ni chapelle du Sacré-Cœur.
          Ces deux éléments furent construits
          vers <strong>1850</strong>.
        </p>

        <p>
          Le presbytère communiquait alors
          directement avec l'église,
          sous la chaire.
        </p>

        <p>
          Une châsse contenant
          une relique de Saint Loup
          y était également installée.
        </p>

      </div>

    </div>

  </section>


  <!-- =====================================
       GRANDES ÉTAPES
  ====================================== -->

  <section class="section">

    <div class="container">

      <div class="section-heading">

        <span class="section-eyebrow">
          Évolution
        </span>

        <h2>Les principales transformations</h2>

      </div>


      <div class="travaux-list">


        <article class="travaux-card">

          <div class="travaux-number">
            1550
          </div>

          <div>

            <h3>Construction de l'église</h3>

            <p>
              Construction de l'église
              entre environ 1550 et 1560.
            </p>

          </div>

        </article>


        <article class="travaux-card">

          <div class="travaux-number">
            1834
          </div>

          <div>

            <h3>Chapelle de la Vierge</h3>

            <p>
              Première restauration connue
              de la chapelle de la Vierge.
            </p>

          </div>

        </article>


        <article class="travaux-card">

          <div class="travaux-number">
            1850
          </div>

          <div>

            <h3>Sacristie et chapelle du Sacré-Cœur</h3>

            <p>
              Construction de la sacristie
              et de la chapelle du Sacré-Cœur.
            </p>

          </div>

        </article>


        <article class="travaux-card">

          <div class="travaux-number">
            XXe
          </div>

          <div>

            <h3>Nouvelle restauration</h3>

            <p>
              La chapelle de la Vierge
              fut restaurée une nouvelle fois
              par une famille du village,
              pour lui donner l'aspect
              que nous lui connaissons aujourd'hui.
            </p>

          </div>

        </article>


        <article class="travaux-card">

          <div class="travaux-number">
            2003
          </div>

          <div>

            <h3>Restauration complète</h3>

            <p>
              Une nouvelle restauration
              extérieure et intérieure
              de l'église est réalisée.
            </p>

          </div>

        </article>


      </div>

    </div>

  </section>


  <!-- =====================================
       À DÉCOUVRIR
  ====================================== -->

  <section class="demarches-info">

    <div class="container demarches-info-grid">

      <div>

        <span class="section-eyebrow light">
          La commune
        </span>

        <h2>Découvrir le patrimoine local</h2>

        <p>
          Retrouvez les autres pages consacrées
          à l'histoire et au patrimoine
          de Saint-Loup-Cammas.
        </p>

      </div>


      <div class="demarches-contact">

        <a href="/histoire">
          Histoire →
        </a>

        <a href="/mairie-patrimoine">
          La Mairie →
        </a>

        <a href="/ecole-patrimoine">
          L'École →
        </a>

        <a href="/blason">
          Blason →
        </a>

      </div>

    </div>

  </section>

</main>

<%- include("partials/footer") %>