<%- include("partials/header", { title }) %>

<main>

  <section class="page-hero">

    <div class="container">

      <span class="section-eyebrow light">
        Mairie
      </span>

      <h1>
        Contact
      </h1>

      <p>
        Retrouvez les coordonnées, horaires
        et informations pratiques de la mairie
        de Saint-Loup-Cammas.
      </p>

    </div>

  </section>


  <section class="section">

    <div class="container contact-page-grid">


      <!-- COORDONNEES -->

      <div class="contact-page-card">

        <span class="section-eyebrow">
          Nous contacter
        </span>

        <h2>
          Mairie de Saint-Loup-Cammas
        </h2>


        <div class="contact-detail">

          <span class="contact-detail-icon">
            ☎️
          </span>

          <div>

            <strong>
              Téléphone
            </strong>

            <a href="tel:0534272850">
              05 34 27 28 50
            </a>

          </div>

        </div>


        <div class="contact-detail">

          <span class="contact-detail-icon">
            🕐
          </span>

          <div>

            <strong>
              Horaires
            </strong>

            <p>
              Du lundi au vendredi<br>
              9h00 – 12h00<br>
              13h30 – 17h30
            </p>

            <p>
              Samedi<br>
              8h30 – 12h00
            </p>

          </div>

        </div>

      </div>


      <!-- ACCES -->

      <div class="contact-page-card">

        <span class="section-eyebrow">
          Venir en mairie
        </span>

        <h2>
          Accès
        </h2>

        <p>
          Retrouvez facilement la mairie
          et préparez votre itinéraire.
        </p>

        <a
          href="https://www.google.com/maps/search/?api=1&query=Mairie+Saint-Loup-Cammas"
          target="_blank"
          rel="noopener"
          class="btn btn-primary"
        >
          Voir sur Google Maps
        </a>

      </div>

    </div>

  </section>


  <!-- CONTACT RAPIDE -->

  <section class="demarches-info">

    <div class="container demarches-info-grid">

      <div>

        <span class="section-eyebrow light">
          Besoin d'un renseignement ?
        </span>

        <h2>
          Contactez la mairie
        </h2>

        <p>
          Les services municipaux sont à votre disposition
          pour vous accompagner dans vos démarches
          et répondre à vos questions.
        </p>

      </div>


      <div class="demarches-contact">

        <strong>
          Mairie de Saint-Loup-Cammas
        </strong>

        <a href="tel:0534272850">
          05 34 27 28 50
        </a>

      </div>

    </div>

  </section>

</main>

<%- include("partials/footer") %>