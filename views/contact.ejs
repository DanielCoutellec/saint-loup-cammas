            </span>

          </div>

        </a>


        <!-- ÉTAT CIVIL -->

        <a href="/etat-civil" class="demarche-card">

          <div class="demarche-icon">
            📄
          </div>

          <div>

            <h3>État civil</h3>

            <p>
              Actes, mariage, PACS,
              naissance et démarches familiales.
            </p>

            <span>
              Consulter →
            </span>

          </div>

        </a>


        <!-- URBANISME -->

        <a href="/urbanisme" class="demarche-card">

          <div class="demarche-icon">
            🏗️
          </div>

          <div>

            <h3>Urbanisme</h3>

            <p>
              PLU, autorisations de travaux
              et demandes d'urbanisme.
            </p>

            <span>
              Consulter →
            </span>

          </div>

        </a>

      </div>

    </div>

  </section>


