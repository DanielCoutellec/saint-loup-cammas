      <div class="demarches-contact">

        <strong>
          Mairie de Saint-Loup-Cammas
        </strong>

        <a href="tel:0534272850">
          05 34 27 28 50
        </a>

        <a href="mailto:mairie@mairie-saintloupcammas.fr">
          mairie@mairie-saintloupcammas.fr
        </a>

      </div>

    </div>

  </section>

</main>

