        <h2>Mairie de Saint-Loup-Cammas</h2>


        <!-- TÉLÉPHONE -->

        <div class="contact-detail">

          <span class="contact-detail-icon">
            ☎️
          </span>

          <div>

            <strong>
              Téléphone
            </strong>

            <a href="tel:0534272850">
              05 34 27 28 50
            </a>

          </div>

        </div>


        <!-- EMAIL -->

        <div class="contact-detail">

          <span class="contact-detail-icon">
            ✉️
          </span>

          <div>

            <strong>
              E-mail
            </strong>

            <a href="mailto:mairie@mairie-saintloupcammas.fr">
              mairie@mairie-saintloupcammas.fr
            </a>

          </div>

        </div>


        <!-- HORAIRES -->

        <div class="contact-detail">

          <span class="contact-detail-icon">
            🕐
          </span>

          <div>

            <strong>
              Horaires d'ouverture
            </strong>

            <p>
              Lundi, mercredi et vendredi<br>
              9h00 – 12h00<br>
              13h30 – 17h30
            </p>

            <p>
              Mardi et jeudi<br>
              8h30 – 12h00<br>
              13h30 – 17h30
            </p>

            <p>
              Samedi<br>
              8h30 – 12h00<br>
              <small>
                Fermé le samedi pendant l'été
              </small>
            </p>

          </div>

        </div>

      </div>


      <!-- =====================================
           ACCÈS
      ====================================== -->

      <div class="contact-page-card">

        <span class="section-eyebrow">
          Venir en mairie
        </span>

        <h2>Accès</h2>

        <p>
          Retrouvez facilement la mairie
          et préparez votre itinéraire.
        </p>


        <!-- ADRESSE -->

        <div class="contact-detail">

          <span class="contact-detail-icon">
            📍
          </span>

          <div>

            <strong>
              Mairie de Saint-Loup-Cammas
            </strong>

            <p>
              Place Magnau<br>
              31140 Saint-Loup-Cammas
            </p>

          </div>

        </div>


        <!-- GOOGLE MAPS -->

        <a
          href="https://www.google.com/maps/search/?api=1&query=Mairie+de+Saint-Loup-Cammas+Place+Magnau+31140"
