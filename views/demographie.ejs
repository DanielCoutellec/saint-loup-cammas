<%- include("partials/header", { title }) %>

<main>

  <!-- =====================================
       HERO
  ====================================== -->

  <section class="page-hero">

    <div class="container">

      <span class="section-eyebrow light">
        La commune
      </span>

      <h1>Démographie</h1>

      <p>
        Retrouvez quelques repères sur l'évolution
        de la population et du développement
        de Saint-Loup-Cammas.
      </p>

    </div>

  </section>


  <!-- =====================================
       ÉVOLUTION DÉMOGRAPHIQUE
  ====================================== -->

  <section class="section">

    <div class="container">

      <div class="section-heading">

        <span class="section-eyebrow">
          Évolution démographique
        </span>

        <h2>Permis de construire</h2>

        <p>
          Le développement de la commune
          s'est accompagné de nombreuses constructions
          au fil des décennies.
        </p>

      </div>


      <div class="documents-year">

        <h3>1960 à 1970</h3>

        <div class="documents-list">

          <div class="document-row">

            <div>
              <strong>Permis de construire</strong>
              <span>66</span>
            </div>

          </div>

        </div>

      </div>


      <div class="documents-year">

        <h3>1971 à 1990</h3>

        <div class="documents-list">

          <div class="document-row">

            <div>
              <strong>Permis de construire</strong>
              <span>300</span>
            </div>

          </div>

        </div>

      </div>


      <div class="documents-year">

        <h3>1991 à 2000</h3>

        <div class="documents-list">

          <div class="document-row">

            <div>
              <strong>Permis de construire</strong>
              <span>195</span>
            </div>

          </div>

        </div>

      </div>


      <div class="documents-year">

        <h3>2001 à 2010</h3>

        <div class="documents-list">

          <div class="document-row">

            <div>
              <strong>Permis de construire</strong>
              <span>244</span>
            </div>

          </div>

        </div>

      </div>


      <div class="documents-year">

        <h3>2011 à 2020</h3>

        <div class="documents-list">

          <div class="document-row">

            <div>
              <strong>Permis de construire</strong>
              <span>294</span>
            </div>

          </div>

        </div>

      </div>

    </div>

  </section>


  <!-- =====================================
       ÉVOLUTION DE LA POPULATION
  ====================================== -->

  <section class="section useful-light-section">

    <div class="container">

      <div class="section-heading">

        <span class="section-eyebrow">
          Population
        </span>

        <h2>Évolution de la population</h2>

        <p>
          La création des infrastructures,
          du réseau routier, de l'assainissement,
          des équipements scolaires, sportifs et associatifs
          a permis d'accompagner l'évolution de la population
          à Saint-Loup-Cammas.
        </p>

      </div>


      <div class="demarches-grid">

        <div class="demarche-card">

          <div class="demarche-icon">
            🏘️
          </div>

          <div>

            <h3>Développement de la commune</h3>

            <p>
              La progression de l'habitat
              s'est accompagnée de la création
              de nouveaux équipements et réseaux.
            </p>

          </div>

        </div>


        <div class="demarche-card">

          <div class="demarche-icon">
            🛣️
          </div>

          <div>

            <h3>Infrastructures</h3>

            <p>
              Réseau routier, équipements scolaires,
              sportifs et associatifs ont accompagné
              la croissance de Saint-Loup-Cammas.
            </p>

          </div>

        </div>


        <div class="demarche-card">

          <div class="demarche-icon">
            💧
          </div>

          <div>

            <h3>Assainissement</h3>

            <p>
              Le réseau d'assainissement
              s'est développé progressivement
              avec l'évolution de la population.
            </p>

          </div>

        </div>

      </div>

    </div>

  </section>


  <!-- =====================================
       ASSAINISSEMENT
  ====================================== -->

  <section class="section">

    <div class="container">

      <div class="section-heading">

        <span class="section-eyebrow">
          Assainissement
        </span>

        <h2>Les grandes étapes</h2>

      </div>


      <div class="travaux-list">

        <article class="travaux-card">

          <div class="travaux-number">
            1974
          </div>

          <div>

            <h3>Première station d'épuration</h3>

            <p>
              Construction de la première station d'épuration,
              d'une capacité de 1 000 habitants.
            </p>

            <p>
              Construction de la première tranche du réseau.
            </p>

          </div>

        </article>


        <article class="travaux-card">

          <div class="travaux-number">
            1976
          </div>

          <div>

            <h3>Deuxième tranche du réseau</h3>

          </div>

        </article>


        <article class="travaux-card">

          <div class="travaux-number">
            1980
          </div>

          <div>

            <h3>Troisième tranche du réseau</h3>

          </div>

        </article>


        <article class="travaux-card">

          <div class="travaux-number">
            1982
          </div>

          <div>

            <h3>Quatrième tranche du réseau</h3>

          </div>

        </article>


        <article class="travaux-card">

          <div class="travaux-number">
            1983
          </div>

          <div>

            <h3>Cinquième tranche du réseau</h3>

          </div>

        </article>


        <article class="travaux-card">

          <div class="travaux-number">
            1991
          </div>

          <div>

            <h3>Deuxième station d'épuration</h3>

            <p>
              Mise en service d'une deuxième station
              d'une capacité de 1 500 habitants.
            </p>

          </div>

        </article>

      </div>

    </div>

  </section>


  <!-- =====================================
       DONNÉES
  ====================================== -->

  <section class="section useful-light-section">

    <div class="container">

      <div class="section-heading">

        <span class="section-eyebrow">
          Repères
        </span>

        <h2>Quelques chiffres</h2>

      </div>


      <div class="demarches-grid">

        <div class="demarche-card">

          <div class="demarche-icon">
            👥
          </div>

          <div>

            <h3>2 372 habitants</h3>

            <p>
              Population indiquée
              dans les données historiques
              de la commune.
            </p>

          </div>

        </div>


        <div class="demarche-card">

          <div class="demarche-icon">
            🏠
          </div>

          <div>

            <h3>825 abonnés</h3>

            <p>
              Abonnés raccordés
              à l'assainissement collectif.
            </p>

          </div>

        </div>


        <div class="demarche-card">

          <div class="demarche-icon">
            📏
          </div>

          <div>

            <h3>16 km</h3>

            <p>
              Longueur totale du réseau
              d'assainissement collectif.
            </p>

          </div>

        </div>

      </div>

    </div>

  </section>


