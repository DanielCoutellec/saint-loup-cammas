<%- include("partials/header", { title }) %>

<main>

  <!-- =====================================
       HERO
  ====================================== -->

  <section class="page-hero">

    <div class="container">

      <span class="section-eyebrow light">
        La commune
      </span>

      <h1>L'École</h1>

      <p>
        Découvrez l'histoire de l'école
        et l'évolution du groupe scolaire
        de Saint-Loup-Cammas.
      </p>

    </div>

  </section>


  <!-- =====================================
       LES PREMIÈRES ÉCOLES
  ====================================== -->

  <section class="section">

    <div class="container">

      <div class="section-heading">

        <span class="section-eyebrow">
          Histoire
        </span>

        <h2>De l'école communale au groupe scolaire</h2>

        <p>
          Le développement de l'école
          accompagne depuis longtemps
          l'évolution de Saint-Loup-Cammas.
        </p>

      </div>


      <div class="heritage-grid">

        <div class="heritage-image">

          <img
            src="/images/histoire/ecole-ancienne.jpg"
            alt="Ancienne école communale de Saint-Loup-Cammas"
          >

        </div>


        <div class="heritage-content">

          <p>
            La commune connaît un développement important
            depuis le début du XXe siècle,
            et particulièrement à partir des années 1970.
          </p>

          <p>
            À l'origine, l'enseignement était assuré
            dans les locaux de l'actuelle mairie.
          </p>

          <p>
            De 1969 à 1982,
            l'installation de bâtiments préfabriqués
            permet la création de classes primaires
            et maternelles indépendantes,
            ainsi que d'une cantine.
          </p>

        </div>

      </div>

    </div>

  </section>


  <!-- =====================================
       EFFECTIFS
  ====================================== -->

  <section class="section useful-light-section">

    <div class="container">

      <div class="section-heading">

        <span class="section-eyebrow">
          Évolution
        </span>

        <h2>Les effectifs scolaires</h2>

        <p>
          La progression des effectifs scolaires
          accompagne celle de la population
          de Saint-Loup-Cammas.
        </p>

      </div>


      <div class="documents-year">

        <h3>Repères</h3>

        <div class="documents-list">

          <div class="document-row">
            <div>
              <strong>1959</strong>
              <span>38 élèves — 240 habitants</span>
            </div>
          </div>

          <div class="document-row">
            <div>
              <strong>1971</strong>
              <span>45 élèves — 285 habitants</span>
            </div>
          </div>

          <div class="document-row">
            <div>
              <strong>1984</strong>
              <span>88 élèves — 947 habitants</span>
            </div>
          </div>

          <div class="document-row">
            <div>
              <strong>1988</strong>
              <span>160 élèves — 1 231 habitants</span>
            </div>
          </div>

          <div class="document-row">
            <div>
              <strong>2000</strong>
              <span>230 élèves — 1 755 habitants</span>
            </div>
          </div>

          <div class="document-row">
            <div>
              <strong>2010</strong>
              <span>218 élèves — 1 834 habitants</span>
            </div>
          </div>

          <div class="document-row">
            <div>
              <strong>2021</strong>
              <span>265 élèves — 2 267 habitants</span>
            </div>
          </div>

          <div class="document-row">
            <div>
              <strong>2022</strong>
              <span>258 élèves — 2 363 habitants</span>
            </div>
          </div>

          <div class="document-row">
            <div>
              <strong>2025</strong>
              <span>215 élèves — 2 372 habitants</span>
            </div>
          </div>

        </div>

      </div>

    </div>

  </section>


  <!-- =====================================
       GROUPE SCOLAIRE
  ====================================== -->

  <section class="section">

    <div class="container">

      <div class="section-heading">

        <span class="section-eyebrow">
          Groupe scolaire
        </span>

        <h2>Les grandes étapes</h2>

      </div>


      <div class="travaux-list">

        <article class="travaux-card">

          <div class="travaux-number">
            1986
          </div>

          <div>

            <h3>Construction du nouveau groupe scolaire</h3>

            <p>
              L'école étant devenue trop petite,
              un nouveau groupe scolaire est construit
              et inauguré le 21 juin 1986.
            </p>

            <p>
              Il dispose de classes claires et aérées,
              de sanitaires adaptés,
              d'un restaurant scolaire avec cuisine
              et d'un équipement moderne et fonctionnel.
            </p>

          </div>

        </article>


        <article class="travaux-card">

          <div class="travaux-number">
            1997
          </div>

          <div>

            <h3>Nouveau restaurant scolaire</h3>

            <p>
              Le conseil municipal décide
              de construire un nouveau restaurant scolaire
              aménagé en self-service,
              présenté à l'époque comme le premier
              de ce type dans la région.
            </p>

            <p>
              L'ancien restaurant devenu disponible
              est transformé en classe maternelle.
            </p>

          </div>

        </article>


        <article class="travaux-card">

          <div class="travaux-number">
            1998
          </div>

          <div>

            <h3>Deux classes supplémentaires</h3>

            <p>
              Deux nouvelles classes sont construites
              et les cours sont réaménagées,
              avec notamment la création
              d'un mur d'escalade.
            </p>

          </div>

        </article>


        <article class="travaux-card">

          <div class="travaux-number">
            2000
          </div>

          <div>

            <h3>Neuf classes</h3>

            <p>
              Le groupe scolaire compte alors
              quatre classes maternelles
              et cinq classes élémentaires.
            </p>

          </div>

        </article>


        <article class="travaux-card">

          <div class="travaux-number">
            2004
          </div>

          <div>

            <h3>Nouvelle extension</h3>

            <p>
              Une nouvelle extension du groupe scolaire
              permet la création d'une bibliothèque,
              d'une salle informatique
              et d'un dortoir supplémentaire.
            </p>

          </div>

        </article>


        <article class="travaux-card">

          <div class="travaux-number">
            2006
          </div>

          <div>

            <h3>Groupe scolaire Claude Nougaro</h3>

            <p>
              Le groupe scolaire est baptisé
              <strong>Claude Nougaro</strong>
              en présence de Madame Hélène Nougaro,
              son épouse.
            </p>

            <p>
              Le nom avait été choisi
              par les enfants du groupe scolaire.
            </p>

          </div>

        </article>


        <article class="travaux-card">

          <div class="travaux-number">
            2022
          </div>

          <div>

            <h3>Le Pré en Bulle</h3>

            <p>
              Le nouveau bâtiment destiné
              au centre de loisirs,
              dont la construction avait commencé
              à partir de 2020,
              est achevé en 2022.
            </p>

            <p>
              L'extension de la cantine,
              devenue trop petite,
              est inaugurée en même temps
              que le centre de loisirs
              <strong>« Le Pré en Bulle »</strong>
              le 15 octobre 2022.
            </p>

          </div>

        </article>

      </div>

    </div>

  </section>


  <!-- =====================================
       AUJOURD'HUI
  ====================================== -->

  <section class="section useful-light-section">

    <div class="container">

      <div class="section-heading">

        <span class="section-eyebrow">
          Aujourd'hui
        </span>

        <h2>Le groupe scolaire actuel</h2>

      </div>


      <div class="demarches-grid">

        <div class="demarche-card">

          <div class="demarche-icon">
            🧸
          </div>

          <div>

            <h3>3 classes maternelles</h3>

            <p>
              Le groupe scolaire accueille
              actuellement trois classes
              en maternelle.
            </p>

          </div>

        </div>


        <div class="demarche-card">

          <div class="demarche-icon">
            🎒
          </div>

          <div>

            <h3>6 classes élémentaires</h3>

            <p>
              Six classes accueillent
              les élèves de l'école élémentaire.
            </p>

          </div>

        </div>


        <a href="/ecole" class="demarche-card">

          <div class="demarche-icon">
            🏫
          </div>

          <div>

            <h3>École Claude Nougaro</h3>

            <p>
              Retrouvez les informations pratiques
              sur l'école actuelle,
              les inscriptions et la vie scolaire.
            </p>

            <span>
              Consulter →
            </span>

          </div>

        </a>

      </div>

    </div>

  </section>


  <!-- =====================================
       À DÉCOUVRIR
  ====================================== -->

  <section class="demarches-info">

    <div class="container demarches-info-grid">

      <div>

        <span class="section-eyebrow light">
          La commune
        </span>

        <h2>Découvrir l'histoire locale</h2>

        <p>
          Retrouvez les autres pages consacrées
          à l'histoire et au patrimoine
          de Saint-Loup-Cammas.
        </p>

      </div>


      <div class="demarches-contact">

        <a href="/histoire">
          Histoire →
        </a>

        <a href="/mairie-patrimoine">
          La Mairie →
        </a>

        <a href="/blason">
          Blason →
        </a>

      </div>

    </div>

  </section>

</main>

<%- include("partials/footer") %>