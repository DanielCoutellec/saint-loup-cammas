<%- include("partials/header", { title }) %>

<main>

  <section class="page-hero">
    <div class="container">

      <span class="section-eyebrow light">
        La mairie
      </span>

      <h1>Le maire et les élus</h1>

      <p>
        Découvrez l'équipe municipale de Saint-Loup-Cammas.
      </p>

    </div>
  </section>


  <!-- MAIRE -->

  <section class="section mayor-section">
    <div class="container">

      <div class="section-heading center-heading">

        <span class="section-eyebrow">
          Équipe municipale
        </span>

        <h2>Le maire</h2>

      </div>


      <div class="mayor-card">

        <img
          src="/images/elus/sandrine-penavaire.jpg"
          alt="Sandrine Penavaire"
        >

        <div class="elu-info">

          <h3>Sandrine Penavaire</h3>

          <span>
            Maire de Saint-Loup-Cammas
          </span>

          <p>
            Madame le Maire et les adjoints reçoivent sur rendez-vous.
          </p>

        </div>

      </div>

    </div>
  </section>


  <!-- ADJOINTS -->

  <section class="section elected-section">

    <div class="container">

      <div class="section-heading center-heading">

        <span class="section-eyebrow">
          Conseil municipal
        </span>

        <h2>Les adjoints</h2>

      </div>


      <div class="elected-grid">

        <article class="elected-card">

          <img
            src="/images/elus/guillaume-de-almeida-chaves.jpg"
            alt="Guillaume de Almeida Chaves"
          >

          <div class="elu-info">
            <h3>Guillaume de Almeida Chaves</h3>
            <span>1er adjoint</span>
          </div>

        </article>


        <article class="elected-card">

          <img
            src="/images/elus/corinne-calvignac.jpg"
            alt="Corinne Calvignac"
          >

          <div class="elu-info">
            <h3>Corinne Calvignac</h3>
            <span>2e adjointe</span>
          </div>

        </article>


        <article class="elected-card">

          <img
            src="/images/elus/claude-milhau.jpg"
            alt="Claude Milhau"
          >

          <div class="elu-info">
            <h3>Claude Milhau</h3>
            <span>3e adjoint</span>
          </div>

        </article>


        <article class="elected-card">

          <img
            src="/images/elus/alice-raynaud.jpg"
            alt="Alice Raynaud"
          >

          <div class="elu-info">
            <h3>Alice Raynaud</h3>
            <span>4e adjointe</span>
          </div>

        </article>

      </div>

    </div>

  </section>


  <!-- CONSEILLERS -->

  <section class="section councillors-section">

    <div class="container">

      <div class="section-heading center-heading">

        <span class="section-eyebrow">
          Conseil municipal
        </span>

        <h2>Les conseillers municipaux</h2>

      </div>


      <div class="councillors-photo-grid">

        <article class="councillor-card">

          <img
            src="/images/elus/jean-luc-ricard.jpg"
            alt="Jean-Luc Ricard"
          >

          <div class="elu-info">
            <h3>Jean-Luc Ricard</h3>
            <span>Conseiller municipal</span>
          </div>

        </article>


        <article class="councillor-card">

          <img
            src="/images/elus/marc-mermoz.jpg"
            alt="Marc Mermoz"
          >

          <div class="elu-info">
            <h3>Marc Mermoz</h3>
            <span>Conseiller municipal</span>
          </div>

        </article>


        <article class="councillor-card">

          <img
            src="/images/elus/jocelyne-conejero-megias.jpg"
            alt="Jocelyne Conejero-Megias"
          >

          <div class="elu-info">
            <h3>Jocelyne Conejero-Megias</h3>
            <span>Conseillère municipale</span>
          </div>

        </article>


        <article class="councillor-card">

          <img
            src="/images/elus/jean-louis-fernandez.jpg"
            alt="Jean-Louis Fernandez"
          >

          <div class="elu-info">
            <h3>Jean-Louis Fernandez</h3>
            <span>Conseiller municipal</span>
          </div>

        </article>


        <article class="councillor-card">

          <img
            src="/images/elus/veronique-faure-mangel.jpg"
            alt="Véronique Faure Mangel"
          >

          <div class="elu-info">
            <h3>Véronique Faure Mangel</h3>
            <span>Conseillère municipale</span>
          </div>

        </article>


        <article class="councillor-card">

          <img
            src="/images/elus/conchita-raynaud.jpg"
            alt="Conchita Raynaud"
          >

          <div class="elu-info">
            <h3>Conchita Raynaud</h3>
            <span>Conseillère municipale</span>
          </div>

        </article>


        <article class="councillor-card">

          <img
            src="/images/elus/muriel-demarcq.jpg"
            alt="Muriel Demarcq"
          >

          <div class="elu-info">
            <h3>Muriel Demarcq</h3>
            <span>Conseillère municipale</span>
          </div>

        </article>


        <article class="councillor-card">

          <img
            src="/images/elus/veronique-deltort.jpg"
            alt="Véronique Deltort"
          >

          <div class="elu-info">
            <h3>Véronique Deltort</h3>
            <span>Conseillère municipale</span>
          </div>

        </article>


        <article class="councillor-card">

          <img
            src="/images/elus/laurence-prudon.jpg"
            alt="Laurence Prudon"
          >

          <div class="elu-info">
            <h3>Laurence Prudon</h3>
            <span>Conseillère municipale</span>
          </div>

        </article>


        <article class="councillor-card">

          <img
            src="/images/elus/helene-heintz.jpg"
            alt="Hélène Heintz"
          >

          <div class="elu-info">
            <h3>Hélène Heintz</h3>
            <span>Conseillère municipale</span>
          </div>

        </article>

      </div>

    </div>

  </section>

</main>

<%- include("partials/footer") %>