  <section class="appointment-section">

    <div class="container appointment-box">

      <div>

        <span class="section-eyebrow light">
          Rencontrer vos élus
        </span>

        <h2>
          Prendre rendez-vous
        </h2>

        <p>
          Le maire et les adjoints reçoivent sur rendez-vous.
        </p>

      </div>


      <div class="appointment-action">

        <a
          href="tel:0534272850"
          class="btn btn-light"
        >
          05 34 27 28 50
        </a>

      </div>

    </div>

