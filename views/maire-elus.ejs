<%- include("partials/header", { title }) %>

<main>

  <!-- EN-TÊTE DE PAGE -->

  <section class="page-hero">
    <div class="container">

      <span class="section-eyebrow light">
        La mairie
      </span>

      <h1>
        Le maire et les élus
      </h1>

      <p>
        Découvrez l'équipe municipale de Saint-Loup-Cammas.
      </p>

    </div>
  </section>


  <!-- LE MAIRE -->

  <section class="section mayor-section">

    <div class="container">

      <div class="section-heading center-heading">

        <span class="section-eyebrow">
          Équipe municipale
        </span>

        <h2>
          Le maire
        </h2>

      </div>


      <div class="mayor-showcase">

        <img
          src="/images/elus/sandrine-penavaire.png"
          alt="Sandrine Penavaire, maire de Saint-Loup-Cammas"
        >

        <p class="appointment-text">
          Madame le Maire et les adjoints reçoivent sur rendez-vous.
        </p>

      </div>

    </div>

  </section>


  <!-- LES ADJOINTS -->

  <section class="section elected-section">

    <div class="container">

      <div class="section-heading center-heading">

        <span class="section-eyebrow">
          Conseil municipal
        </span>

        <h2>
          Les adjoints
        </h2>

      </div>


      <div class="elected-grid">

        <!-- 1er ADJOINT -->

        <article class="elected-card">

          <img
            src="/images/elus/guillaume-de-almeida-chaves.png"
            alt="Guillaume de Almeida Chaves, 1er adjoint"
            class="elected-photo-img"
          >

        </article>


        <!-- 2e ADJOINTE -->

        <article class="elected-card">

          <img
            src="/images/elus/corinne-calvignac.jpg"
            alt="Corinne Calvignac, 2e adjointe"
            class="elected-photo-img"
          >

        </article>


        <!-- 3e ADJOINT -->

        <article class="elected-card">

          <img
            src="/images/elus/claude-milhau.jpg"
            alt="Claude Milhau, 3e adjoint"
            class="elected-photo-img"
          >

        </article>


        <!-- 4e ADJOINTE -->

        <article class="elected-card">

          <img
            src="/images/elus/alice-raynaud.jpg"
            alt="Alice Raynaud, 4e adjointe"
            class="elected-photo-img"
          >

        </article>

      </div>

    </div>

  </section>


