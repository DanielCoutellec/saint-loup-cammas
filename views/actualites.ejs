<%- include("partials/header", { title }) %>

<main>

  <!-- =====================================
       HERO
  ====================================== -->

  <section class="page-hero">

    <div class="container">

      <span class="section-eyebrow light">
        La commune vous informe
      </span>

      <h1>Actualités</h1>

      <p>
        Retrouvez les dernières informations,
        alertes et actualités de Saint-Loup-Cammas.
      </p>

    </div>

  </section>


  <!-- =====================================
       ACTUALITÉS
  ====================================== -->

  <section class="section">

    <div class="container">

      <div class="section-heading">

        <span class="section-eyebrow">
          À la une
        </span>

        <h2>Les dernières actualités</h2>

        <p>
          Informations municipales,
          alertes et événements de la commune.
        </p>

      </div>


      <div class="demarches-grid">

        <% actualites.forEach(actualite => { %>

          <%
            // Le Plan canicule possède désormais
            // sa propre page dédiée.
            const lien =
              actualite.slug === "plan-canicule"
                ? "/plan-canicule"
                : "/actualites/" + actualite.slug;
          %>

          <a
            href="<%= lien %>"
            class="demarche-card"
          >

            <div class="demarche-icon">

              <% if (actualite.slug === "plan-canicule") { %>

                ☀️

              <% } else if (actualite.slug === "alerte-prelevement-eau") { %>

                💧

              <% } else if (actualite.slug === "enquete-insee-emploi-du-temps") { %>

                📊

              <% } else { %>

                📰

              <% } %>

            </div>


            <div>

              <span class="section-eyebrow">
                <%= actualite.categorie %>
              </span>

              <h3>
                <%= actualite.titre %>
              </h3>

              <p>
                <%= actualite.resume %>
              </p>

              <span>
                En savoir plus →
              </span>

            </div>

          </a>

        <% }) %>

      </div>

    </div>

  </section>


  <!-- =====================================
       AGENDA
  ====================================== -->

  <section class="section useful-light-section">

    <div class="container">

      <div class="section-heading">

        <span class="section-eyebrow">
          À vos agendas
        </span>

        <h2>Les événements de la commune</h2>

        <p>
          Retrouvez les prochaines manifestations,
          animations et rendez-vous
          organisés à Saint-Loup-Cammas.
        </p>

      </div>


      <div class="demarches-grid">

        <a
          href="/agenda"
          class="demarche-card"
        >

          <div class="demarche-icon">
            📅
          </div>

          <div>

            <h3>Agenda</h3>

            <p>
              Consultez les prochains événements
              et manifestations de la commune.
            </p>

            <span>
              Voir l'agenda →
            </span>

          </div>

        </a>

      </div>

    </div>

  </section>


  <!-- =====================================
       CONTACT
  ====================================== -->

  <section class="demarches-info">

    <div class="container demarches-info-grid">

      <div>

        <span class="section-eyebrow light">
          Votre mairie
        </span>

        <h2>
          Besoin d'un renseignement ?
        </h2>

        <p>
          Pour toute question concernant
          une information municipale,
          contactez les services de la mairie.
        </p>

      </div>


      <div class="demarches-contact">

        <strong>
          Mairie de Saint-Loup-Cammas
        </strong>

        <a href="tel:0534272850">
          05 34 27 28 50
        </a>

        <a href="mailto:mairie@mairie-saintloupcammas.fr">
          mairie@mairie-saintloupcammas.fr
        </a>

        <a href="/contact">
          Contact & accès →
        </a>

      </div>

    </div>

  </section>

</main>

<%- include("partials/footer") %>