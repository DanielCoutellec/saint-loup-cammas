<%- include("partials/header", { title }) %>

<main>

  <!-- =====================================
       HERO
  ====================================== -->

  <section class="page-hero">

    <div class="container">

      <span class="section-eyebrow light">
        La commune
      </span>

      <h1>Histoire</h1>

      <p>
        Découvrez Saint-Loup-Cammas,
        son territoire et son cadre de vie
        au fil de son histoire.
      </p>

    </div>

  </section>


  <!-- =====================================
       PRÉSENTATION
  ====================================== -->

  <section class="section">

    <div class="container">

      <div class="section-heading">

        <span class="section-eyebrow">
          Saint-Loup-Cammas
        </span>

        <h2>
          Un village des coteaux toulousains
        </h2>

        <p>
          Saint-Loup-Cammas fait partie
          des communes dites « des coteaux »
          et bénéficie d'une situation géographique privilégiée.
        </p>

      </div>


      <div class="heritage-grid">


        <!-- PHOTO ANCIENNE -->

        <div class="heritage-image">

          <img
            src="/images/histoire/saint-loup-ancien.jpg"
            alt="Vue ancienne de Saint-Loup-Cammas"
          >

        </div>


        <!-- TEXTE -->

        <div class="heritage-content">

          <h3>
            Un territoire dominant les vallées
          </h3>

          <p>
            Située à une altitude d'environ 200 mètres,
            la commune domine, vers le sud,
            la vallée de la Garonne et la ville de Toulouse,
            distante d'environ 12 kilomètres.
          </p>

          <p>
            Par temps clair, il est également possible
            d'apercevoir la chaîne des Pyrénées.
          </p>

          <p>
            Au nord, la vallée du Girou offre un point de vue
            sur Montberon, Bazus, Montjoire,
            Vacquiers et Garidech.
          </p>

        </div>

      </div>

    </div>

  </section>


  <!-- =====================================
       CADRE DE VIE
  ====================================== -->

  <section class="section useful-light-section">

    <div class="container">

      <div class="section-heading">

        <span class="section-eyebrow">
          Cadre de vie
        </span>

        <h2>
          Une commune où il fait bon vivre
        </h2>

      </div>


      <div class="heritage-text">

        <p>
          Saint-Loup-Cammas est depuis longtemps
          appréciée pour son cadre de vie.
          Son environnement résidentiel,
          ses paysages et sa proximité avec Toulouse
          participent à son attractivité.
        </p>

        <p>
          Une grande partie de la commune
          est entourée de bois accessibles
          par de petits chemins aménagés,
          permettant d'agréables promenades.
        </p>

        <p>
          Préserver cette qualité de vie
          constitue un enjeu important
          pour l'avenir de Saint-Loup-Cammas.
        </p>

      </div>

    </div>

  </section>


  <!-- =====================================
       PAYSAGES
  ====================================== -->

  <section class="section">

    <div class="container">

      <div class="section-heading">

        <span class="section-eyebrow">
          Le territoire
        </span>

        <h2>
          Entre Toulouse, Girou et Pyrénées
        </h2>

        <p>
          La situation de Saint-Loup-Cammas
          offre de nombreux points de vue
          sur les paysages environnants.
        </p>

      </div>


      <div class="demarches-grid">


        <div class="demarche-card">

          <div class="demarche-icon">
            🏙️
          </div>

          <div>

            <h3>
              Vers Toulouse
            </h3>

            <p>
              Au sud, les coteaux dominent
              la vallée de la Garonne
              et ouvrent la vue vers Toulouse.
            </p>

          </div>

        </div>


        <div class="demarche-card">

          <div class="demarche-icon">
            🏔️
          </div>

          <div>

            <h3>
              Les Pyrénées
            </h3>

            <p>
              Par temps clair,
              la chaîne des Pyrénées
              peut être aperçue depuis la commune.
            </p>

          </div>

        </div>


        <div class="demarche-card">

          <div class="demarche-icon">
            🌳
          </div>

          <div>

            <h3>
              Vallée du Girou
            </h3>

            <p>
              Au nord, la vallée du Girou
              offre des perspectives vers
              les communes voisines.
            </p>

          </div>

        </div>


      </div>

    </div>

  </section>


  <!-- =====================================
       À DÉCOUVRIR
  ====================================== -->

  <section class="section useful-light-section">

    <div class="container">

      <div class="section-heading">

        <span class="section-eyebrow">
          Découvrir la commune
        </span>

        <h2>
          Histoire & patrimoine
        </h2>

      </div>


      <div class="demarches-grid">


        <a href="/commune-patrimoine" class="demarche-card">

          <div class="demarche-icon">
            ⛪
          </div>

          <div>

            <h3>
              Patrimoine
            </h3>

            <p>
              Découvrez l'église,
              le château de Loubens,
              les paysages et le patrimoine local.
            </p>

            <span>
              Découvrir →
            </span>

          </div>

        </a>


        <a href="/vie-locale" class="demarche-card">

          <div class="demarche-icon">
            🌿
          </div>

          <div>

            <h3>
              Vie locale
            </h3>

            <p>
              Retrouvez les services,
              associations et équipements
              de Saint-Loup-Cammas.
            </p>

            <span>
              Consulter →
            </span>

          </div>

        </a>


      </div>

    </div>

  </section>


  <!-- =====================================
       CONTACT
  ====================================== -->

  <section class="demarches-info">

    <div class="container demarches-info-grid">

      <div>

        <span class="section-eyebrow light">
          Saint-Loup-Cammas
        </span>

        <h2>
          En savoir plus sur la commune
        </h2>

        <p>
          Pour toute information complémentaire
          concernant l'histoire ou le patrimoine local,
          vous pouvez contacter la mairie.
        </p>

      </div>


      <div class="demarches-contact">

        <strong>
          Mairie de Saint-Loup-Cammas
        </strong>

        <a href="tel:0534272850">
          05 34 27 28 50
        </a>

        <a href="/contact">
          Contact & accès →
        </a>

      </div>

    </div>

  </section>

</main>

<%- include("partials/footer") %>