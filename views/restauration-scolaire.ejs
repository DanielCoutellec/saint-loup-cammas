<%- include("partials/header", { title }) %>

<main>

  <!-- =====================================
       HERO
  ====================================== -->

  <section class="page-hero">
    <div class="container">

      <span class="section-eyebrow light">
        Enfance
      </span>

      <h1>Restauration scolaire</h1>

      <p>
        Retrouvez les informations pratiques concernant
        les repas, les menus et le fonctionnement
        de la restauration scolaire à Saint-Loup-Cammas.
      </p>

    </div>
  </section>


  <!-- =====================================
       FONCTIONNEMENT
  ====================================== -->

  <section class="section">

    <div class="container">

      <div class="section-heading">

        <span class="section-eyebrow">
          Restaurant scolaire
        </span>

        <h2>Les repas des enfants</h2>

        <p>
          Le restaurant scolaire fonctionne
          tous les jours de classe
          et accueille les enfants
          du groupe scolaire Claude Nougaro.
        </p>

      </div>


      <div class="demarches-grid">

        <div class="demarche-card">

          <div class="demarche-icon">
            🍽️
          </div>

          <div>

            <h3>Tous les jours de classe</h3>

            <p>
              Le restaurant scolaire fonctionne
              pendant les jours de classe,
              durant la pause méridienne.
            </p>

          </div>

        </div>


        <div class="demarche-card">

          <div class="demarche-icon">
            👧
          </div>

          <div>

            <h3>À partir de 36 mois</h3>

            <p>
              Seuls les enfants âgés
              d'au moins 36 mois
              peuvent être accueillis à la cantine.
            </p>

          </div>

        </div>


        <div class="demarche-card">

          <div class="demarche-icon">
            ✏️
          </div>

          <div>

            <h3>Inscription obligatoire</h3>

            <p>
              Aucun enfant ne peut être accueilli
              au restaurant scolaire
              sans inscription préalable.
            </p>

          </div>

        </div>

      </div>

    </div>

  </section>


  <!-- =====================================
       GRÈVE
  ====================================== -->

  <section class="section useful-light-section">

    <div class="container">

      <div class="municipal-alert">

        <div class="alert-icon">
          !
        </div>

        <div>

          <strong>
            En cas de grève
          </strong>

          <p>
            En cas de grève des enseignants
            ou du personnel de l'école,
            le restaurant scolaire
            ne fonctionne pas.
          </p>

          <p>
            Toutefois, selon les situations,
            des solutions de remplacement
            peuvent être envisagées au cas par cas.
          </p>

        </div>

      </div>

    </div>

  </section>


  <!-- =====================================
       VACANCES SCOLAIRES
  ====================================== -->

  <section class="section">

    <div class="container">

      <div class="section-heading">

        <span class="section-eyebrow">
          Vacances scolaires
        </span>

        <h2>Repas pendant les vacances</h2>

        <p>
          Pendant les périodes de fonctionnement
          de l'accueil de loisirs,
          certaines règles spécifiques s'appliquent
          à la restauration.
        </p>

      </div>


      <div class="demarches-grid">

        <div class="demarche-card">

          <div class="demarche-icon">
            🍴
          </div>

          <div>

            <h3>Minimum 5 repas</h3>

            <p>
              Le nombre minimum de repas
              pouvant être livrés est de cinq.
            </p>

          </div>

        </div>


        <div class="demarche-card">

          <div class="demarche-icon">
            🥪
          </div>

          <div>

            <h3>Moins de 5 repas</h3>

            <p>
              Lorsque moins de cinq repas sont prévus,
              l'enfant doit apporter
              un repas froid.
            </p>

          </div>

        </div>

      </div>

    </div>

  </section>


  <!-- =====================================
       MENUS
  ====================================== -->

  <section class="section useful-light-section">

    <div class="container">

      <div class="section-heading">

        <span class="section-eyebrow">
          Menus
        </span>

        <h2>Les menus de votre enfant</h2>

        <p>
          Les menus du restaurant scolaire
          sont disponibles directement
          sur le Portail Familles.
        </p>

      </div>


      <div class="demarches-grid">

        <a
          href="https://saintloupcammas.portail-familles.app/"
          target="_blank"
          rel="noopener"
          class="demarche-card"
        >

          <div class="demarche-icon">
            🥗
          </div>

          <div>

            <h3>Consulter les menus</h3>

            <p>
              Retrouvez les menus proposés
              aux enfants sur le Portail Familles.
            </p>

            <span>
              Voir les menus →
            </span>

          </div>

        </a>


        <a
          href="https://saintloupcammas.portail-familles.app/"
          target="_blank"
          rel="noopener"
          class="demarche-card"
        >

          <div class="demarche-icon">
            👨‍👩‍👧
          </div>

          <div>

            <h3>Portail Familles</h3>

            <p>
              Gérez également vos réservations,
              modifications, annulations
              et informations familiales.
            </p>

            <span>
              Accéder au portail →
            </span>

          </div>

        </a>

      </div>

    </div>

  </section>


  <!-- =====================================
       INSCRIPTIONS
  ====================================== -->

  <section class="section">

    <div class="container">

      <div class="section-heading">

        <span class="section-eyebrow">
          Démarches
        </span>

        <h2>Inscription & réservation</h2>

        <p>
          L'inscription préalable est obligatoire
          pour bénéficier du service
          de restauration scolaire.
        </p>

      </div>


      <div class="demarches-grid">

        <a
          href="https://saintloupcammas.portail-familles.app/"
          target="_blank"
          rel="noopener"
          class="demarche-card"
        >

          <div class="demarche-icon">
            📅
          </div>

          <div>

            <h3>Réserver un repas</h3>

            <p>
              Les réservations et modifications
              peuvent être effectuées
              depuis le Portail Familles.
            </p>

            <span>
              Accéder au portail →
            </span>

          </div>

        </a>


        <a href="/contact" class="demarche-card">

          <div class="demarche-icon">
            ☎️
          </div>

          <div>

            <h3>Besoin d'aide ?</h3>

            <p>
              Pour toute question
              concernant l'inscription
              ou le fonctionnement du service,
              contactez la mairie.
            </p>

            <span>
              Contacter la mairie →
            </span>

          </div>

        </a>

      </div>

    </div>

  </section>


  <!-- =====================================
       AUTRES SERVICES
  ====================================== -->

  <section class="section useful-light-section">

    <div class="container">

      <div class="section-heading">

        <span class="section-eyebrow">
          École
        </span>

        <h2>Autour de la restauration scolaire</h2>

      </div>


      <div class="demarches-grid">

        <a href="/ecole" class="demarche-card">

          <div class="demarche-icon">
            🏫
          </div>

          <div>

            <h3>École Claude Nougaro</h3>

            <p>
              Retrouvez les informations pratiques,
              horaires et contacts
              du groupe scolaire.
            </p>

            <span>
              Voir l'école →
            </span>

          </div>

        </a>


        <a href="/accueils-loisirs" class="demarche-card">

          <div class="demarche-icon">
            🎨
          </div>

          <div>

            <h3>Accueils de loisirs</h3>

            <p>
              Retrouvez les informations concernant
              les accueils périscolaires
              et extrascolaires.
            </p>

            <span>
              Consulter →
            </span>

          </div>

        </a>


        <a href="/enfance" class="demarche-card">

          <div class="demarche-icon">
            👨‍👩‍👧
          </div>

          <div>

            <h3>Enfance</h3>

            <p>
              Retrouvez l'ensemble des services
              proposés aux enfants
              et aux familles.
            </p>

            <span>
              Voir la rubrique →
            </span>

          </div>

        </a>

      </div>

    </div>

  </section>


  <!-- =====================================
       CONTACT
  ====================================== -->

  <section class="demarches-info">

    <div class="container demarches-info-grid">

      <div>

        <span class="section-eyebrow light">
          Restauration scolaire
        </span>

        <h2>Une question sur la cantine ?</h2>

        <p>
          Pour toute question concernant
          les inscriptions, les repas,
          les menus ou le fonctionnement
          de la restauration scolaire,
          contactez la mairie.
        </p>

      </div>


      <div class="demarches-contact">

        <strong>
          Mairie de Saint-Loup-Cammas
        </strong>

        <a href="tel:0534272850">
          05 34 27 28 50
        </a>

        <a
          href="https://saintloupcammas.portail-familles.app/"
          target="_blank"
          rel="noopener"
        >
          Portail Familles →
        </a>

        <a href="/contact">
          Contact & accès →
        </a>

      </div>

    </div>

  </section>

</main>

<%- include("partials/footer") %>