<%- include("partials/header", { title }) %>

<main>

  <!-- EN-TÊTE DE L'ACTUALITÉ -->

  <section class="page-hero">

    <div class="container">

      <span class="section-eyebrow light">
        <%= actualite.categorie %>
      </span>

      <h1>
        <%= actualite.titre %>
      </h1>

      <p>
        <%= actualite.resume %>
      </p>

    </div>

  </section>


  <!-- CONTENU DE L'ACTUALITÉ -->

  <section class="section actualite-detail">

    <div class="container">

      <div class="actualite-detail-grid">


        <!-- IMAGE -->

        <% if (actualite.image) { %>

          <div class="actualite-detail-image">

            <img
              src="<%= actualite.image %>"
              alt="<%= actualite.titre %>"
            >

          </div>

        <% } %>


        <!-- TEXTE -->

        <div class="actualite-detail-content">

          <span class="section-eyebrow">
            <%= actualite.categorie %>
          </span>

          <h2>
            <%= actualite.titre %>
          </h2>

          <p>
            <%= actualite.contenu %>
          </p>

          <a href="/actualites" class="text-link">
            ← Retour aux actualités
          </a>

        </div>


      </div>

    </div>

  </section>

</main>

<%- include("partials/footer") %>