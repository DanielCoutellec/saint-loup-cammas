<%- include("partials/header", { title }) %>

<main>

  <!-- =====================================
       HERO
  ====================================== -->

  <section class="page-hero">
    <div class="container">

      <span class="section-eyebrow light">
        Développement durable
      </span>

      <h1>Environnement & déchets</h1>

      <p>
        Collecte des déchets, tri, déchets verts,
        déchetteries, encombrants et compostage :
        retrouvez les informations pratiques
        pour Saint-Loup-Cammas.
      </p>

    </div>
  </section>


  <!-- =====================================
